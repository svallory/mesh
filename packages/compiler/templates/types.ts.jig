// Do not edit this file by hand.
// It is generated by `mesh build` from {{ entityFile }}; change that file and rebuild.

@each(type in imports)
import type { {{ type.name }} } from {{ type.fromLiteral }};

@end
export type {{ record.name }} = {
  @each(member in record.members)
  {{ member.key }}: {{ member.type }};
  @end
};

@each(input in inputs)
export type {{ input.name }} = {
  @if(input.empty)
  [key: string]: never;
  @end
  @each(member in input.members)
  {{ member.key }}: {{ member.type }};
  @end
};

@end
