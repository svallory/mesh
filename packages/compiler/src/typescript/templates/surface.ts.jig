// Do not edit this file by hand.
// It is generated by `mesh build` from {{ surfaceFile }}; change that file and rebuild.
// The {{ name }} surface's manifest: import it as "{{ specifier }}". Each action calls the entity's own action with the
// caller's context, so every policy and check applies, and returns only the fields its expose line lists.

import {
  @each(name in runtimeImports)
  {{ name }},
  @end
} from "@meshfw/runtime";
@if(globals)
{{ globals.keyword }} { {{ globals.names }} } from {{ globals.fromLiteral }};
@end
@each(entity in entityImports)
import { {{ entity.value }} } from {{ entity.actionsFromLiteral }};
@if(entity.types.length)
import type {
  @each(name in entity.types)
  {{ name }},
  @end
} from {{ entity.typesFromLiteral }};
@end
@end

@each(exposure in exposures)
// {{ exposure.comment }}: the record properties that leave
const {{ exposure.fieldsLocal }} = {{ exposure.fieldsLiteral }} as const;
@if(exposure.fieldsType)
type {{ exposure.fieldsType }} = (typeof {{ exposure.fieldsLocal }})[number];
@end
@if(exposure.loadableLocal)
// the listed computed fields a read may load
const {{ exposure.loadableLocal }} = {{ exposure.loadableLiteral }} as const;
@end
@if(exposure.loadableTypeLine)
{{ exposure.loadableTypeLine }}
@end

@end
export const surface = $defineSurface({
  name: {{ nameLiteral }},
  expose: {
    @each(exposure in exposures)
    {{ exposure.key }}: {
      entity: {{ exposure.entityLiteral }},
      label: {{ exposure.labelLiteral }},
      fields: {{ exposure.fieldsLocal }},
      actions: {
        @each(action in exposure.actions)
        {{ action.key }}: {
          kind: {{ action.kindLiteral }},
          async run{{ action.generics }}(input: {{ action.inputType }}, ...context: $ContextArgument): $Promise<{{ action.returnType }}> {
            @each(statement in action.statements)
            {{ statement }}
            @end
          },
        },
        @end
      },
    },
    @end
  },
  publishes: [
    @each(event in publishes)
    {{ event }},
    @end
  ],
});
