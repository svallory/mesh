// It is generated by `mesh build` from the entity files; change them and rebuild.
// The types of `actions` and `tx`, which the functions of an entity file and an application's `transaction` callback receive.

@if(hasActions)
import type { ActionContext as $ActionContext, DeepReadonly as $DeepReadonly } from "@meshfw/runtime";
@end
@each(entry in imports)
import type { {{ entry.names }} } from {{ entry.fromLiteral }};
@end

/** Every action function of the project, bound to the running transaction: a call joins it, and carries the caller's context unless it passes its own. */
export interface Actions {
  @each(fn in actions)
  readonly {{ fn.name }}: {{ fn.generics }}(input: {{ fn.inputType }}, context?: $ActionContext) => Promise<{{ fn.returnType }}>;
  @end
}

/** One function per read action, reading inside the running transaction. A read through `tx` runs no read policy. */
export interface Reads {
  @each(fn in reads)
  readonly {{ fn.name }}: {{ fn.generics }}(input: {{ fn.inputType }}) => Promise<{{ fn.returnType }}>;
  @end
}

/**
 * `Actions` as a function of an entity file receives them: every result deeply read-only. Written out, not mapped over
 * `Actions`, because a read is generic in the names its `load` lists and a mapped type would lose that. `Actions` is
 * assignable to it.
 */
export interface ReadOnlyActions {
  @each(fn in actions)
  readonly {{ fn.name }}: {{ fn.generics }}(input: {{ fn.inputType }}, context?: $ActionContext) => Promise<$DeepReadonly<{{ fn.returnType }}>>;
  @end
}

/** `Reads` as a function of an entity file receives them (`tx`): every result deeply read-only. `Reads` is assignable to it. */
export interface ReadOnlyReads {
  @each(fn in reads)
  readonly {{ fn.name }}: {{ fn.generics }}(input: {{ fn.inputType }}) => Promise<$DeepReadonly<{{ fn.returnType }}>>;
  @end
}
