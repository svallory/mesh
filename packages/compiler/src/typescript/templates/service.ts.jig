// Do not edit this file by hand.
// It is generated by `mesh build` from {{ serviceFile }}; change that file and rebuild.
// The service value `{{ name }}`: one method per operation (`{{ name }}.<operation>(input, context)`). Mesh's own names carry a
// `$`, so the helpers the service file imports keep the names it gives them.

import {
  @each(name in runtimeValues)
  {{ name }},
  @end
  type ActionContext as $ActionContext,
  type ContextArgument as $ContextArgument,
  type OperationSpec as $OperationSpec,
  type Scope as $Scope,
  @if(usesSharedInput)
  type SharedInput as $SharedInput,
  @end
} from "@meshfw/runtime";
@each(helper in helperImports)
{{ helper.keyword }} {{ helper.bindings }} from {{ helper.fromLiteral }};
@end
@each(imported in entityImports)
{{ imported.keyword }} { {{ imported.names }} } from {{ imported.fromLiteral }};
@end
import {
  @each(name in inputValueImports)
  {{ name }},
  @end
  @each(name in inputTypeImports)
  type {{ name }},
  @end
} from {{ inputsFromLiteral }};
@if(globals)
{{ globals.keyword }} { {{ globals.names }} } from {{ globals.fromLiteral }};
@end
@each(namespace in entityNamespaces)
declare namespace {{ namespace.name }} { {{ namespace.members }} }
@end

/** What every function of {{ name }} reads; `I` is the input of the operation it runs for. */
type {{ scopeName }}<I = unknown> = {{ scopeType }};
/** What a function resolves with: a method's result is its operation's body's. */
type $Returns<F> = F extends (...args: never) => infer R ? R : never;

const $expressions = {
  @each(entry in entries)
  // {{ entry.comment }}
  {{ entry.key }}: {{ entry.code }},
  @end
} as const;

// Each entry is checked as an `OperationSpec` of its own: an operation named like an `Object.prototype` member
// (`toString`) takes its contextual type from Object, not from the table's type, so its policy kinds would widen to string.
const {{ valueLocal }} = $service({{ fqnLiteral }}, {
  @each(operation in operations)
  {{ operation.key }}: {
    schema: {{ operation.schemaLocal }},
    policies: {{ operation.policies }},
    uses: {{ operation.uses }},
    body: {{ operation.body }},
  } satisfies $OperationSpec,
  @end
}, (call) => ({
  @each(operation in operations)
  {{ operation.key }}(input: {{ operation.inputLocal }}, ...context: $ContextArgument): $Returns<typeof {{ operation.body }}> {
    return call({{ operation.nameLiteral }}, input, context);
  },
  @end
}));

export { {{ valueLocal }} as {{ name }} };
