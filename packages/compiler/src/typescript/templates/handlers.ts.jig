// Do not edit this file by hand.
// It is generated by `mesh build` from {{ ownerFile }}; change that file and rebuild.
// The handlers of the `handlers` section of {{ ownerFqn }}, by kind and key: the generated `bind` merges them with the other
// owners' (`mergeHandlers`) and hands them to `bindDomain`, which registers them beside the events module's. Mesh's own
// names carry a `$`, so the helpers the file imports keep the names it gives them.

import {
  @each(name in runtimeValues)
  {{ name }},
  @end
  type ActionContext as $ActionContext,
  type EventRecord as $EventRecord,
  type SectionHandlers as $SectionHandlers,
} from "@meshfw/runtime";
@each(helper in helperImports)
{{ helper.keyword }} {{ helper.bindings }} from {{ helper.fromLiteral }};
@end
@each(imported in entityImports)
{{ imported.keyword }} { {{ imported.names }} } from {{ imported.fromLiteral }};
@end
@each(imported in classImports)
{{ imported.keyword }} { {{ imported.names }} } from {{ imported.fromLiteral }};
@end
@if(globals)
{{ globals.keyword }} { {{ globals.names }} } from {{ globals.fromLiteral }};
@end
@each(namespace in entityNamespaces)
declare namespace {{ namespace.name }} { {{ namespace.members }} }
@end

/** What a handler body reads: the event, one of those its `on=` lists, and the context it runs with. */
type $HandlerScope<E extends object> = { readonly event: $EventRecord<E>; readonly context: $ActionContext };

export const $handlers: $SectionHandlers = {
  process: {
    @each(entry in processHandlers)
    // {{ entry.comment }}
    {{ entry.keyLiteral }}: $handler({
      events: {{ entry.eventsLiteral }},
      run: async (event, { context }) => {
        await ({{ entry.code }})({ event, context });
      },
      @if(entry.renamedFromLiteral)
      renamedFrom: {{ entry.renamedFromLiteral }},
      @end
    }),
    @end
  },
  listen: {
    @each(entry in listenHandlers)
    // {{ entry.comment }}
    {{ entry.keyLiteral }}: $handler({
      events: {{ entry.eventsLiteral }},
      run: async (event, { context }) => {
        await ({{ entry.code }})({ event, context });
      },
      @if(entry.renamedFromLiteral)
      renamedFrom: {{ entry.renamedFromLiteral }},
      @end
    }),
    @end
  },
  at: {
    @each(entry in processHandlers)
    {{ entry.keyLiteral }}: {{ entry.atLiteral }},
    @end
    @each(entry in listenHandlers)
    {{ entry.keyLiteral }}: {{ entry.atLiteral }},
    @end
  },
};
