// Do not edit this file by hand.
// It is generated by `mesh build` from the entity files; change them and rebuild.
// Import it as "#mesh": `bind`, `connect`, `disconnect`, `transaction`, the `Binding` type, the type `Privileged` (what
// `Mesh.privileged` returns; `Mesh` comes from "meshfw") and the data adapter's `tables`. An entity's value and types come
// from its module, never from here:
@each(specifier in modules)
//   "{{ specifier }}"
@end
// The other files in this folder are an implementation detail.

export { bind, connect, disconnect, transaction, type Binding } from "./binding";
export type { Privileged } from "@meshfw/runtime";
export { tables } from "./schema";
@if(events)

// The project's events: the types `DomainEvent`, `EventRecord` and `MetadataFunction`, the table `eventClasses`, `published`
// and the functions of delivery; the event and command classes come from their module.
@each(imported in events.imports)
import { {{ imported.name }} as {{ imported.local }} } from {{ imported.fromLiteral }};
@end
{{ events.globals.keyword }} { {{ events.globals.names }} } from {{ events.globals.fromLiteral }};
import type { EventRecord as $EventRecord, MetadataFunction as $MetadataFunction } from "@meshfw/runtime";

/** The instance type of every event class of the project: what a delivered event is. */
export type DomainEvent = {{ events.union }};
/** A published event as a reader gets it: the envelope, the project's metadata and the event itself (`payload`). */
export type EventRecord<E extends DomainEvent = DomainEvent> = $EventRecord<E>;
/** The type of the events module's `metadata` function: `export const metadata: MetadataFunction = ({ event, context }) => ({ ... })`. */
export type MetadataFunction = $MetadataFunction<DomainEvent>;
export type { EventMetadata } from "@meshfw/runtime";
/** `published()`, the running transaction's own events, and the functions of delivery. */
export { published, forgetHandler, forgetSubscription, listSubscriptions, resumeHandler, type ConnectOptions } from "./binding";
export type { Delivery, SubscriptionProgress } from "@meshfw/runtime";
@if(events.replay)
/** `readEvents(query)`, a page of the outbox's kept events: the bus declares replay. */
export { readEvents } from "./binding";
export type { ReadEventsPage, ReadEventsQuery } from "@meshfw/runtime";
@end
@if(events.subscribe)
/** `subscribe(query, callback)`, a live subscription: the bus declares subscribe. */
export { subscribe } from "./binding";
export type { SubscribeQuery, Subscription } from "@meshfw/runtime";
@end
/** Every event class of the project by its FQN, which turns a stored row back into an instance: `new eventClasses["billing.InvoicePaid"](payload)`. */
export const eventClasses = $Object.freeze({
  @each(entry in events.table)
  {{ entry.fqnLiteral }}: {{ entry.local }},
  @end
});

// The configured bus's capabilities, so that a handler option it cannot honour is a type error.
declare module "@meshfw/runtime" {
  interface EventBusCapabilities {
    @each(capability in events.busCapabilities)
    {{ capability }}: true;
    @end
  }
}
@end
@if(commands)

// The commands an action answers (`on=`): `dispatch(command, context)` runs the action, and joins the running transaction.
@each(imported in commands.entities)
import { {{ imported.name }} as {{ imported.local }} } from {{ imported.fromLiteral }};
@end
@each(imported in commands.imports)
import type { {{ imported.name }} as {{ imported.local }} } from {{ imported.fromLiteral }};
@end
@if(commands.globals)
{{ commands.globals.keyword }} { {{ commands.globals.names }} } from {{ commands.globals.fromLiteral }};
@end
import { dispatchCommand as $dispatchCommand, type ActionContext as $ActionContext, type ActionResult as $ActionResult, type CommandAction as $CommandAction } from "@meshfw/runtime";

/** The instance type of every command class an action answers: what `dispatch` takes. */
export type DomainCommand = {{ commands.union }};
/** What `dispatch` resolves with: what the action that answers the command returns. */
export type DispatchResult<C extends DomainCommand> =
  @each(entry in commands.results)
  C extends {{ entry.command }} ? $ActionResult<typeof {{ entry.entity }}.{{ entry.action }}> :
  @end
  never;

const $commandActions: { readonly [fqn: string]: $CommandAction } = {
  @each(entry in commands.table)
  {{ entry.fqnLiteral }}: { run: ({{ entry.param }}: {{ entry.command }}, context) => {{ entry.entity }}.{{ entry.action }}({{ entry.input }}, context) },
  @end
};

/**
 * Runs the action whose `on=` names the command's class, with the command's fields as its input and the `context` given.
 * Inside a transaction (an action's, a `process` handler's, `transaction()`'s) the action joins it; outside, it opens its own.
 * Resolves with what the action returns, and rejects with what it throws.
 */
export function dispatch<C extends DomainCommand>(command: C, context: $ActionContext): $Promise<DispatchResult<C>> {
  return $dispatchCommand($commandActions, command, context) as $Promise<DispatchResult<C>>;
}
@end
