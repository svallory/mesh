// Do not edit this file by hand.
// It is generated by `mesh build` from the entity files; change them and rebuild.
// Import it as "#mesh": `bind`, `connect`, `disconnect`, `transaction`, the `Binding` type, the type `Privileged` (what
// `Mesh.privileged` returns; `Mesh` comes from "meshfw") and the data adapter's `tables`. An entity's value and types come
// from its module, never from here:
@each(specifier in modules)
//   "{{ specifier }}"
@end
// The other files in this folder are an implementation detail.

export { bind, connect, disconnect, transaction, type Binding } from "./binding";
export type { Privileged } from "@meshfw/runtime";
export { tables } from "./schema";
@if(events)

// The project's events: the types `DomainEvent`, `EventRecord` and `MetadataFunction`, the table `eventClasses`, `published`
// and `readEvents`; the event and command classes come from their module.
@each(imported in events.imports)
import { {{ imported.name }} as {{ imported.local }} } from {{ imported.fromLiteral }};
@end
{{ events.globals.keyword }} { {{ events.globals.names }} } from {{ events.globals.fromLiteral }};
import type { EventRecord as $EventRecord, MetadataFunction as $MetadataFunction } from "@meshfw/runtime";

/** The instance type of every event class of the project: what a delivered event is. */
export type DomainEvent = {{ events.union }};
/** A published event as a reader gets it: the envelope, the project's metadata and the event itself (`payload`). */
export type EventRecord<E extends DomainEvent = DomainEvent> = $EventRecord<E>;
/** The type of the events module's `metadata` function: `export const metadata: MetadataFunction = ({ event, context }) => ({ ... })`. */
export type MetadataFunction = $MetadataFunction<DomainEvent>;
export type { EventMetadata, ReadEventsPage, ReadEventsQuery } from "@meshfw/runtime";
/** `published()`, the running transaction's own events, and `readEvents(query)`, a page of the outbox's kept events. */
export { published, readEvents } from "./binding";
/** Every event class of the project by its FQN, which turns a stored row back into an instance: `new eventClasses["billing.InvoicePaid"](payload)`. */
export const eventClasses = $Object.freeze({
  @each(entry in events.table)
  {{ entry.fqnLiteral }}: {{ entry.local }},
  @end
});
@end
