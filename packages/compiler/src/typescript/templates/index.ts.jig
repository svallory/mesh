// Do not edit this file by hand.
// It is generated by `mesh build` from the entity files; change them and rebuild.
// Import it as "#mesh"; the other files in this folder are an implementation detail.
// Mesh's own imports and internal names carry a `$` so that no entity or action name can collide with them.

import {
  FrameworkError as $FrameworkError,
  @if(hasFunctions)~
  type ContextArgument as $ContextArgument,
  @end~
  type DataLayer as $DataLayer,
} from "@meshfw/runtime";
@each(entity in entities)
@if(entity.hasActions)~
import { {{ entity.bindName }} } from {{ entity.actionsFromLiteral }};
@end~
import type {
  @each(name in entity.types)
  {{ name }},
  @end
} from {{ entity.typesFromLiteral }};
@end

export type {
  @each(name in types)
  {{ name }},
  @end
};
export {
  @each(name in schemaExports)
  {{ name }},
  @end
} from "./schema";
@if(loaders.length)
export {
  @each(name in loaders)
  {{ name }},
  @end
} from "./load";
@end

/**
 * Every action function, bound to `layer`. Opens nothing and creates no table:
 * the caller owns the layer and closes it.
 */
@if(hasFunctions)
export function bind(layer: $DataLayer) {
  @each(entity in entities)
  @if(entity.hasActions)~
  const {{ entity.local }} = {{ entity.bindName }}(layer);
  @end~
  @end
  return Object.freeze({
    @each(fn in functions)
    {{ fn.name }}: {{ fn.method }},
    @end
  });
}
@else
export function bind(_layer: $DataLayer) {
  return Object.freeze({});
}
@end

let $defaultBinding: ReturnType<typeof bind> | undefined;
let $defaultLayer: $DataLayer | undefined;
let $disconnecting: Promise<void> | undefined;
/** Calls through the top-level functions that have not settled; `disconnect()` waits for them. */
let $inFlight = 0;
const $idle: (() => void)[] = [];

function $isDataLayer(value: unknown): value is $DataLayer {
  return typeof value === "object" && value !== null
    && typeof (value as Partial<$DataLayer>).transaction === "function"
    && typeof (value as Partial<$DataLayer>).close === "function";
}

/**
 * Bind every action function to the data layer `mesh.config.ts` configures. The
 * layer opens on the first transaction. Waits for a `disconnect()` in progress;
 * throws `FrameworkError` while connected.
 */
export async function connect(): Promise<void> {
  if ($disconnecting) await $disconnecting;
  if ($defaultLayer) throw new $FrameworkError("connect() was called while connected; call disconnect() first");
  const { default: config } = await import({{ configFromLiteral }});
  const data: unknown = config.data;
  if (!$isDataLayer(data))
    throw new $FrameworkError(
      `The data adapter "${config.data.name}" configured in mesh.config.ts has no run-time half: connect() needs a data layer with transaction() and close()`,
    );
  if ($defaultLayer) throw new $FrameworkError("connect() was called while connected; call disconnect() first");
  $defaultBinding = bind(data);
  $defaultLayer = data;
}

/**
 * Stop new calls, wait for the calls already made through the top-level functions to
 * settle, however long they take, then close the layer `connect()` bound. Does nothing
 * when not connected. If `close()` rejects, the binding is restored and the program
 * stays connected, so `disconnect()` can be called again. Never closes a layer passed
 * to `bind`.
 */
export async function disconnect(): Promise<void> {
  if ($disconnecting) return $disconnecting;
  const layer = $defaultLayer;
  const binding = $defaultBinding;
  if (!layer || !binding) return;
  $defaultBinding = undefined;
  $defaultLayer = undefined;
  $disconnecting = (async () => {
    while ($inFlight > 0) await new Promise<void>((resolve) => $idle.push(resolve));
    try {
      await layer.close();
    } catch (error) {
      $defaultBinding = binding;
      $defaultLayer = layer;
      throw error;
    }
  })();
  try {
    await $disconnecting;
  } finally {
    $disconnecting = undefined;
  }
}

@if(hasFunctions)
/** Run one call on the default binding, counted so that `disconnect()` waits for it. */
async function $delegate<T>(name: string, call: (binding: ReturnType<typeof bind>) => Promise<T>): Promise<T> {
  if (!$defaultBinding)
    throw new $FrameworkError(`${name} was called while not connected: call connect() first, or use bind(db) with a data layer of your own`);
  $inFlight++;
  try {
    return await call($defaultBinding);
  } finally {
    $inFlight--;
    if ($inFlight === 0) for (const resolve of $idle.splice(0)) resolve();
  }
}

@end
@each(fn in functions)
export async function {{ fn.name }}(input: {{ fn.inputType }}, ...context: $ContextArgument): Promise<{{ fn.returnType }}> {
  return $delegate({{ fn.nameLiteral }}, (binding) => binding.{{ fn.name }}(input, ...context));
}

@end
