// Do not edit this file by hand.
// It is generated by `mesh build` from the entity files; change them and rebuild.
// Mesh's own file: `bind`, the default binding and `transaction`. Import `#mesh` for them, and `#mesh/domain/<path>`
// for the entity values, which run each call on the binding in scope, else on the one `connect()` opens.
// Mesh's own imports and internal names carry a `$` so that no entity or action name can collide with them.

import {
  bindDomain as $bindDomain,
  bindingInScope as $bindingInScope,
  connectBinding as $connectBinding,
  FrameworkError as $FrameworkError,
  releaseBinding as $releaseBinding,
  settled as $settled,
  type BindOptions as $BindOptions,
  type Binding as $Binding,
  type ContextArgument as $ContextArgument,
  type DataLayer as $DataLayer,
  type Seams as $Seams,
} from "@meshfw/runtime";
import * as $domain from {{ domainFromLiteral }};
import type { Actions, Reads } from "./composition";

/**
 * The whole domain bound to one data layer: `run(fn)` runs `fn` with the binding in scope, so every entity call in it
 * (`Task.create(input, context)`) runs on this binding, and `transaction(fn, context)` runs `fn` in one transaction on it.
 */
export type Binding = $Binding<Actions, Reads>;

/**
 * Bind every entity of the domain to `layer`, with the clock and seams of `options`. Opens nothing and creates no
 * table: the caller owns the layer and closes it.
 */
export function bind(layer: $DataLayer, options: $BindOptions = {}): Binding {
  // The walk runs here, not when this file loads, so every barrel has finished loading.
  return $bindDomain<Actions, Reads>($domain, layer, options);
}

let $defaultBinding: Binding | undefined;
let $defaultLayer: $DataLayer | undefined;
let $disconnecting: Promise<void> | undefined;

function $isDataLayer(value: unknown): value is $DataLayer {
  return typeof value === "object" && value !== null
    && typeof (value as Partial<$DataLayer>).transaction === "function"
    && typeof (value as Partial<$DataLayer>).refuseIfFailed === "function"
    && typeof (value as Partial<$DataLayer>).close === "function";
}

/**
 * Bind every entity to the data layer `mesh.config.ts` configures: an entity call made outside any `run` or
 * `transaction` runs on it. The layer opens on the first transaction. Waits for a `disconnect()` in progress;
 * throws `FrameworkError` while connected.
 */
export async function connect(): Promise<void> {
  if ($disconnecting) await $disconnecting;
  if ($defaultLayer) throw new $FrameworkError("connect() was called while connected; call disconnect() first");
  const { default: config } = await import({{ configFromLiteral }});
  const data: unknown = config.data;
  if (!$isDataLayer(data))
    throw new $FrameworkError(
      `The data adapter "${config.data.name}" configured in mesh.config.ts has no run-time half: connect() needs a data layer with transaction(), refuseIfFailed() and close()`,
    );
  if ($defaultLayer) throw new $FrameworkError("connect() was called while connected; call disconnect() first");
  // `config` is read as the project wrote it, so a configuration that is not typed with `defineConfig` still binds.
  const binding = bind(data, { seams: (config as { readonly seams?: $Seams }).seams });
  $connectBinding(binding);
  $defaultBinding = binding;
  $defaultLayer = data;
}

/**
 * Stop new calls, wait for the calls already made on the connected binding to settle, however long they take, then
 * close the layer `connect()` bound. Does nothing when not connected. If `close()` rejects, the binding is restored
 * and the program stays connected, so `disconnect()` can be called again. Never closes a layer passed to `bind`.
 */
export async function disconnect(): Promise<void> {
  if ($disconnecting) return $disconnecting;
  const layer = $defaultLayer;
  const binding = $defaultBinding;
  if (!layer || !binding) return;
  $releaseBinding(binding);
  $defaultBinding = undefined;
  $defaultLayer = undefined;
  $disconnecting = (async () => {
    await $settled(binding);
    try {
      await layer.close();
    } catch (error) {
      $connectBinding(binding);
      $defaultBinding = binding;
      $defaultLayer = layer;
      throw error;
    }
  })();
  try {
    await $disconnecting;
  } finally {
    $disconnecting = undefined;
  }
}

/**
 * Open a transaction, or join the running one, on the binding in scope (the innermost `run` or `transaction` this call
 * is made inside), else on the connected one, and call `fn({ actions, tx })`: every action function and every read,
 * bound to it, carrying `context` unless a call passes its own. Resolves with what `fn` resolves with. A call through
 * `actions` or `tx` that fails fails the whole transaction, even when `fn` catches it.
 */
export async function transaction<T>(fn: (composition: { readonly actions: Actions; readonly tx: Reads }) => Promise<T>, ...context: $ContextArgument): Promise<T> {
  const binding = ($bindingInScope() as Binding | undefined) ?? $defaultBinding;
  if (!binding)
    throw new $FrameworkError("transaction was called while not connected: call connect() first, or call it inside run() of bind(db) with a data layer of your own");
  return binding.transaction(fn, ...context);
}
