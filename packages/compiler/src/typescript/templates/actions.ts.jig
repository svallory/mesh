// Do not edit this file by hand.
// It is generated by `mesh build` from {{ entityFile }}; change that file and rebuild.
// Mesh's own imports carry a `$` so that no entity name can shadow them.

@if(hasActions)
import {
  @each(name in runtimeValues)
  {{ name }},
  @end
  type ContextArgument as $ContextArgument,
  type DataLayer as $DataLayer,
} from "@meshfw/runtime";
import type {
  @each(name in typeImports)
  {{ name }},
  @end
} from {{ typesFromLiteral }};
import {
  @each(name in validatorImports)
  {{ name }},
  @end
} from {{ validatorsFromLiteral }};
import { tables } from {{ schemaFromLiteral }};

export function {{ bindName }}(layer: $DataLayer) {
  return Object.freeze({
    @each(method in methods)
    async {{ method.name }}(input: {{ method.inputType }}, ...[_context]: $ContextArgument): Promise<{{ method.returnType }}> {
      @if(method.notRun)
      // {{ method.notRun }}
      @end
      @if(method.unsupported)
      await parseInput({{ method.validator }}, input);
      throw new $FrameworkError({{ method.unsupported }});
      @else
      @if(method.usesParsed)~
      const parsed = await parseInput({{ method.validator }}, input);
      @else~
      await parseInput({{ method.validator }}, input);
      @end~
      return layer.transaction(async (tx) => {
        @each(statement in method.statements)
        {{ statement }}
        @end
      });
      @end
    },

    @end
  });
}
@else
import type { DataLayer as $DataLayer } from "@meshfw/runtime";

export function {{ bindName }}(_layer: $DataLayer) {
  return Object.freeze({});
}
@end
