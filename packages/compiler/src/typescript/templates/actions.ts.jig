    @each(body in reads)
    async {{ body.name }}{{ body.generics }}(input: {{ body.inputType }}{{ body.contextParam }}): Promise<{{ body.returnType }}> {
      @if(body.unsupported)
      await $castInput(layer, {{ body.validator }}, input);
      return $failJoined(layer, new $FrameworkError({{ body.unsupported }}));
      @else
      @if(body.usesParsed)~
      // enter, cast: only the declared input passes; a failed cast inside a transaction fails it. The read action casts it
      // for its policies and hands it over as `cast`; a `privileged` read casts it here.
      const parsed = cast ?? (await $castInput(layer, {{ body.validator }}, input));
      @else~
      // enter, cast: only the declared input passes; a failed cast inside a transaction fails it
      await $castInput(layer, {{ body.validator }}, input);
      @end~
      return layer.transaction(async (tx) => {
        @each(statement in body.statements)
        {{ statement }}
        @end
      });
      @end
    },

    @end
  });
}

