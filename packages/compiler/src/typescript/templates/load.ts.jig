/** What `loadRows` follows: each entity's table and key, its relationships and its computed fields. */
export const loadPlan = {
  @each(entity in entities)
  {{ entity.nameLiteral }}: {
    table: {{ entity.table }},
    key: {{ entity.keyLiteral }},
    relations: {
      @each(relation in entity.relations)
      {{ relation.key }}: {{ relation.plan }},
      @end
    },
    computed: {
      @each(field in entity.computed)
      {{ field.key }}: {{ field.plan }},
      @end
    },
  },
  @end
} as const satisfies $LoadPlan;
@each(entity in entities)
@if(entity.loader)

/**
 * Load relationships and computed fields onto {{ entity.loader.record }} rows by name. A relationship is loaded by one more
 * query for all the rows; a computed field loads what its body reads first. The rows you pass are not changed:
 * the result is new rows of type {{ entity.loader.with }}<"name" | ...>.
 */
export async function {{ entity.loader.name }}<const N extends keyof {{ entity.loader.loadable }}>(
  tx: $DataOperations,
  rows: readonly {{ entity.loader.record }}[],
  names: readonly N[],
  options?: $LoadOptions,
): Promise<{{ entity.loader.with }}<N>[]> {
  return (await $loadRows(loadPlan, {{ entity.loader.entityLiteral }}, tx, rows, names, options)) as {{ entity.loader.with }}<N>[];
}
@end
@end
