// Do not edit this file by hand.
// It is generated by `mesh build` from the entity files; change them and rebuild.
// Mesh's own imports and internal names carry a `$` so that no entity or action name can collide with them.

import type { LoadPlan as $LoadPlan } from "@meshfw/runtime";
import { tables } from {{ schemaFromLiteral }};
@each(source in expressionImports)
import { expressions as {{ source.local }} } from {{ source.fromLiteral }};
@end

/**
 * What `loadRows` follows: each entity's table and key, its relationships and its computed fields, and the read policies
 * a caller's load of it runs (none listed: a caller loads none of its records).
 */
export const loadPlan = {
  @each(entity in entities)
  {{ entity.nameLiteral }}: {
    table: {{ entity.table }},
    key: {{ entity.keyLiteral }},
    relations: {
      @each(relation in entity.relations)
      {{ relation.key }}: {{ relation.plan }},
      @end
    },
    computed: {
      @each(field in entity.computed)
      {{ field.key }}: {{ field.plan }},
      @end
    },
    @if(entity.reads)
    reads: {{ entity.reads }},
    @end
  },
  @end
} as const satisfies $LoadPlan;
