// Do not edit this file by hand.
// It is generated by `mesh build` from the entity files of {{ description }}; change them and rebuild.
// Import it as "{{ specifier }}": the module's action functions, its entities' types and, when it has any, its
// load functions. `bind`, `connect`, `disconnect` and `transaction` come from "#mesh"; the other files in this
// folder are an implementation detail.
// Mesh's own imports carry a `$` so that no entity or action name can collide with them.

@if(hasFunctions)
import type { ContextArgument as $ContextArgument } from "@meshfw/runtime";
import { $delegate } from {{ bindingFromLiteral }};
@end
@each(entity in entities)
import type {
  @each(name in entity.types)
  {{ name }},
  @end
} from {{ entity.typesFromLiteral }};
@end

export type {
  @each(name in types)
  {{ name }},
  @end
};
@if(loadFromLiteral)
export {
  @each(name in loaders)
  {{ name }},
  @end
} from {{ loadFromLiteral }};
@end

@each(fn in functions)
export async function {{ fn.name }}(input: {{ fn.inputType }}, ...context: $ContextArgument): Promise<{{ fn.returnType }}> {
  return $delegate({{ fn.nameLiteral }}, (binding) => binding.{{ fn.name }}(input, ...context));
}

@end
