// Do not edit this file by hand.
// It is generated by `mesh build` from the entity files of {{ description }}; change them and rebuild.
// Import it as "{{ specifier }}": each entity's value, whose methods run its actions
// (`<Entity>.<action>(input, context)`), and record type, its other types and load functions, and one namespace per
// subfolder. `bind`, `connect`, `disconnect` and `transaction` come from "#mesh"; the other files in this folder are an
// implementation detail.

@each(entity in entities)
export {
  @each(name in entity.values)
  {{ name }},
  @end
} from {{ entity.actionsFromLiteral }};
@if(entity.hasTypes)
export type {
  @each(name in entity.types)
  {{ name }},
  @end
} from {{ entity.typesFromLiteral }};
@end
@end
@if(declarations.length)
// The module's event and command classes: `new <Class>({ ... })` makes an instance, `Mesh.fqnOf` names its declaration.
@end
@each(declaration in declarations)
export { {{ declaration.name }} } from {{ declaration.fromLiteral }};
@end
@each(namespace in namespaces)
export * as {{ namespace.name }} from {{ namespace.fromLiteral }};
@end
