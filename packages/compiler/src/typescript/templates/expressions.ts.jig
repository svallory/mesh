// Do not edit this file by hand.
// It is generated by `mesh build` from {{ entityFile }}; change that file and rebuild.

import {
  @if(shadowsStructuredClone)
  cloneValue as $cloneValue,
  @end
  @if(usesExpr)
  expr as $,
  @end
  @if(usesPrivileged)
  privileged as $privileged,
  @end
  type DeepReadonly as $DeepReadonly,
  type Scope as $Scope,
  @if(usesSharedInput)
  type SharedInput as $SharedInput,
  @end
} from "@meshfw/runtime";
@each(helper in helperImports)
import { {{ helper.names }} } from {{ helper.fromLiteral }};
@end
@each(imported in entityImports)
import { {{ imported.names }} } from {{ imported.fromLiteral }};
@end
import type {
  @each(name in typeImports)
  {{ name }},
  @end
} from {{ typesFromLiteral }};

/** What every expression of {{ recordName }} reads; `I` is the input of the action it runs in. */
export type {{ scopeName }}<I = unknown> = {{ scopeType }};
/** What the expressions that only run on a stored record (an update or a destroy) read: `before` is the stored record. */
export type {{ storedScopeName }}<I = unknown> = {{ scopeName }}<I> & { before: $DeepReadonly<{{ recordLocal }}> };
@if(checkScope)
/** What a check reads: `self` is the record before the input is applied, the caller's values are `input`, and there is no `before`. */
export type {{ checkScope.name }}<I = unknown> = {{ checkScope.type }};
@end
@if(newScope)
/** What a check that can run on a create reads: `self` may be the new instance, where what the input or a step fills is still null. */
export type {{ newScope.name }}<I = unknown> = {{ newScope.type }};
@end
@if(createScope)
/** What a step that can run on a create reads before the write: the key is null until the data layer writes the row. */
export type {{ createScope.name }}<I = unknown> = {{ createScope.type }};
@end

export const $expressions = {
  @each(entry in entries)
  // {{ entry.comment }}
  {{ entry.key }}: {{ entry.code }},
  @end
} as const;
