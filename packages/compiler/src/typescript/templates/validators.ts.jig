// Do not edit this file by hand.
// It is generated by `mesh build` from {{ entityFile }}; change that file and rebuild.

@if(hasInputs)
import { z } from "zod";

import type {
  @each(schema in schemas)
  {{ schema.typeName }},
  @end
} from {{ typesFromLiteral }};

type Keys<T> = T extends Record<string, never> ? never : keyof T;

type SameShape<A, B> = [Keys<A>] extends [Keys<B>]
  ? [Keys<B>] extends [Keys<A>]
    ? [A] extends [B]
      ? [B] extends [A]
        ? true
        : false
      : false
    : false
  : false;

type Assert<T extends true> = T;

@each(schema in schemas)
export const {{ schema.constName }} = z.strictObject({
  @each(field in schema.fields)
  {{ field.key }}: {{ field.schema }},
  @end
}) satisfies z.ZodType<{{ schema.typeName }}>;

export type {{ schema.shapeTypeName }} = Assert<SameShape<z.output<typeof {{ schema.constName }}>, {{ schema.typeName }}>>;

@end
@end
