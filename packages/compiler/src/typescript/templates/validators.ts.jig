// Do not edit this file by hand.
// It is generated by `mesh build` from {{ entityFile }}; change that file and rebuild.

@if(hasInputs)
import { z } from "zod";
@if(json)
import { jsonValue as $jsonValue } from "@meshfw/runtime";
@end
@each(concept in concepts)
import { {{ concept.schema }} } from {{ concept.fromLiteral }};
@end

import type {
  @each(schema in schemas)
  {{ schema.typeName }},
  @end
  @if(query)
  @each(name in query.typeImports)
  {{ name }},
  @end
  @end
} from {{ typesFromLiteral }};
@if(globals)
{{ globals.keyword }} { {{ globals.names }} } from {{ globals.fromLiteral }};
@end

type Keys<T> = T extends { [key: string]: never } ? never : keyof T;

type SameShape<A, B> = [Keys<A>] extends [Keys<B>]
  ? [Keys<B>] extends [Keys<A>]
    ? [A] extends [B]
      ? [B] extends [A]
        ? true
        : false
      : false
    : false
  : false;

type Assert<T extends true> = T;

@if(lineRules)
/**
 * Marks the issues of the Mesh file's line rules (`min`, `max`, `match`) with `meshRule: { code, source }`, which
 * `@meshfw/runtime` reads: Zod's own issue code and a top-level field name pick the rule. Zod's safe-integer range check
 * of `z.int()` (origin `int`) is no line rule and stays unmarked. Returns the same schema, its type unchanged.
 */
type $Rules = { readonly [field: string]: { readonly [zodCode: string]: { code: string; source: { file: string; line: number; column: number } } } };
const $ruled = <S extends z.ZodType>(schema: S, rules: $Rules): S => {
  const standard = schema["~standard"];
  const mark = <R extends { readonly issues?: readonly unknown[] | undefined }>(result: R): R =>
    result.issues
      ? ({
          issues: result.issues.map((issue) => {
            const raw = issue as { path?: readonly unknown[]; code?: string; format?: string; origin?: string };
            const key = raw.path?.length === 1 ? raw.path[0] : undefined;
            const field = typeof key === "string" ? key : undefined;
            const zod = raw.code === "invalid_format" && raw.format === "regex" ? "regex" : raw.code;
            const rule = field === undefined || raw.origin === "int" || zod === undefined ? undefined : rules[field]?.[zod];
            return rule ? { ...raw, meshRule: rule } : issue;
          }),
        } as unknown as R)
      : result;
  schema["~standard"] = {
    ...standard,
    validate: (value: unknown) => {
      const result = standard.validate(value);
      return "then" in result ? result.then(mark) : mark(result);
    },
  } as typeof standard;
  return schema;
};

@end
@if(relate)
/**
 * One item of a list a `relate` step takes: an item that holds `key` is checked by `keyed`, any other by `fresh` (a list
 * whose relate names no `create=` takes no new item, `fresh` null; one whose relate names neither `update=` nor
 * `destroy=` takes no keyed item, `keyed` null). The item's issues keep their paths under the list
 * (`["tracks", 1, "name"]`) and the marks of `$ruled`, so a bad field of an item is reported as a bad field of the input.
 */
const $relateItem = <K = never, N = never>(key: string, keyed: z.ZodType<K> | null, fresh: z.ZodType<N> | null) =>
  z.unknown().transform((value, ctx): K | N => {
    const holdsKey = typeof value === "object" && value !== null && key in value && (value as { readonly [key: string]: unknown })[key] !== undefined;
    const schema: z.ZodType<K | N> | null = holdsKey ? keyed : fresh;
    if (schema === null) {
      ctx.addIssue({ code: "custom", message: holdsKey ? `an item may not hold ${key}: this list takes no keyed item` : `an item needs ${key}: this list takes no new item` });
      return z.NEVER;
    }
    const result = schema["~standard"].validate(value);
    // Mesh's item schemas are synchronous; a promise here is a schema it did not generate.
    if ("then" in result) {
      ctx.addIssue({ code: "custom", message: "an item schema must be synchronous" });
      return z.NEVER;
    }
    if (result.issues === undefined) return result.value;
    for (const issue of result.issues) ctx.addIssue({ ...issue, input: undefined } as never);
    return z.NEVER;
  });

@end
@if(query)
const comparison = <T extends z.ZodType>(value: T) =>
  z
    .strictObject({
      eq: value.nullable().exactOptional(),
      ne: value.nullable().exactOptional(),
      lt: value.exactOptional(),
      lte: value.exactOptional(),
      gt: value.exactOptional(),
      gte: value.exactOptional(),
      in: z.array(value).readonly().exactOptional(),
      nil: z.boolean().exactOptional(),
    })
    .refine((operators) => $Object.keys(operators).length > 0, { message: "a comparison needs an operator" });

export const {{ query.filterConst }}: z.ZodType<{{ query.filterTypeName }}> = z.lazy(
  () =>
    z.union([
    z.strictObject({ and: z.array({{ query.filterConst }}).readonly() }),
    z.strictObject({ or: z.array({{ query.filterConst }}).readonly() }),
    z.strictObject({
      @each(field in query.filterFields)
      {{ field.key }}: {{ field.schema }},
      @end
    }),
  ]) as unknown as z.ZodType<{{ query.filterTypeName }}>,
);

export const {{ query.sortConst }} = z
  .array(
    z.enum([
      @each(key in query.sortKeys)
      {{ key }},
      @end
    ]),
  )
  .readonly();

@end
@each(schema in schemas)
@if(schema.rules)
export const {{ schema.constName }} = $ruled(z.strictObject({
  @each(field in schema.fields)
  {{ field.key }}: {{ field.schema }},
  @end
}), {{ schema.rules }}) satisfies z.ZodType<{{ schema.typeName }}{{ schema.typeArguments }}>;
@else
export const {{ schema.constName }} = z.strictObject({
  @each(field in schema.fields)
  {{ field.key }}: {{ field.schema }},
  @end
}) satisfies z.ZodType<{{ schema.typeName }}{{ schema.typeArguments }}>;
@end

export type {{ schema.shapeTypeName }} = Assert<SameShape<z.output<typeof {{ schema.constName }}>, {{ schema.typeName }}{{ schema.typeArguments }}>>;

@end
@end
