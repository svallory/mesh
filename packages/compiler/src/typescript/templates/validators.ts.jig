// Do not edit this file by hand.
// It is generated by `mesh build` from {{ entityFile }}; change that file and rebuild.

@if(hasInputs)
import { z } from "zod";

import type {
  @each(schema in schemas)
  {{ schema.typeName }},
  @end
  @if(query)
  @each(name in query.typeImports)
  {{ name }},
  @end
  @end
} from {{ typesFromLiteral }};

type Keys<T> = T extends Record<string, never> ? never : keyof T;

type SameShape<A, B> = [Keys<A>] extends [Keys<B>]
  ? [Keys<B>] extends [Keys<A>]
    ? [A] extends [B]
      ? [B] extends [A]
        ? true
        : false
      : false
    : false
  : false;

type Assert<T extends true> = T;

@if(query)
const comparison = <T extends z.ZodType>(value: T) =>
  z.strictObject({
    eq: value.nullable().optional(),
    ne: value.nullable().optional(),
    lt: value.optional(),
    lte: value.optional(),
    gt: value.optional(),
    gte: value.optional(),
    in: z.array(value).readonly().optional(),
    nil: z.boolean().optional(),
  });

// The cast is the schema's only gap: zod writes an absent key as `?: T | undefined`, which the
// strictest `exactOptionalPropertyTypes` setting does not let the filter type accept.
export const {{ query.filterConst }}: z.ZodType<{{ query.filterTypeName }}> = z.lazy(
  () =>
    z.union([
    z.strictObject({ and: z.array({{ query.filterConst }}).readonly() }),
    z.strictObject({ or: z.array({{ query.filterConst }}).readonly() }),
    z.strictObject({
      @each(field in query.filterFields)
      {{ field.key }}: {{ field.schema }},
      @end
    }),
  ]) as unknown as z.ZodType<{{ query.filterTypeName }}>,
);

export const {{ query.sortConst }} = z
  .array(
    z.enum([
      @each(key in query.sortKeys)
      {{ key }},
      @end
    ]),
  )
  .readonly();

@end
@each(schema in schemas)
export const {{ schema.constName }} = z.strictObject({
  @each(field in schema.fields)
  {{ field.key }}: {{ field.schema }},
  @end
}) satisfies z.ZodType<{{ schema.typeName }}>;

export type {{ schema.shapeTypeName }} = Assert<SameShape<z.output<typeof {{ schema.constName }}>, {{ schema.typeName }}>>;

@end
@end
