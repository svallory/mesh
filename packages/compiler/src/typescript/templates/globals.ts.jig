// Do not edit this file by hand.
// It is generated by `mesh build`; rebuild to change it.
// The JavaScript globals the generated files use, each under a `$` name. No entity, import alias or helper of an entity
// file can have a name that starts with `$`, so an entity named `Promise` or `Date` hides none of them. This file
// imports nothing and declares no entity name: each right-hand side is the global itself.

@each(alias in aliases)
@if(alias.value)
export const {{ alias.name }} = {{ alias.value }};
@end
@if(alias.type)
export type {{ alias.name }}{{ alias.params }} = {{ alias.type }};
@end
@end
