@if(query)
import type { Comparison as $Comparison } from "@meshfw/runtime";

@end
@each(type in imports)
import type { {{ type.names }} } from {{ type.fromLiteral }};

@end
@if(globals)
{{ globals.keyword }} { {{ globals.names }} } from {{ globals.fromLiteral }};

@end
export type {{ record.name }} = {
  @each(member in record.members)
  {{ member.key }}: {{ member.type }};
  @end
};

@each(input in inputs)
export type {{ input.name }}{{ input.generics }} = {
  @if(input.empty)
  [key: string]: never;
  @end
  @each(member in input.members)
  @if(member.optional)~
  {{ member.key }}?: {{ member.type }};
  @else~
  {{ member.key }}: {{ member.type }};
  @end~
  @end
};

@end
@if(loadable)
/**
 * What a caller's `load` attaches to a {{ record.name }}. The record has none of it, so reading one that was not loaded is a type error.
 * A caller's load runs the read policies of the entity it reaches: a related record the caller may not read is null, a list of them empty.
 * A computed field's body does not (POL-19): it is the entity's own rule, so it reads every related record, and what it
 * returns is shown to every caller who may read a {{ record.name }}. Return only what each such caller may see.
 */
export type {{ loadable.name }} = {
  @each(member in loadable.members)
  {{ member.key }}: {{ member.type }};
  @end
};

/** A {{ record.name }} with the relationships and computed fields named in N loaded. */
export type {{ loadable.withName }}<N extends keyof {{ loadable.name }}> = {{ record.name }} & $Pick<{{ loadable.name }}, N>;
@if(loadable.tx)

/** What a load through `privileged` attaches to a {{ record.name }}: it runs no policy, so every related record the key names is there. */
export type {{ loadable.tx.name }} = {
  @each(member in loadable.tx.members)
  {{ member.key }}: {{ member.type }};
  @end
};

/** A {{ record.name }} loaded through `privileged`, with the relationships and computed fields named in N. */
export type {{ loadable.tx.withName }}<N extends keyof {{ loadable.name }}> = {{ record.name }} & $Pick<{{ loadable.tx.name }}, N>;
@end

/** The names a `load` tuple lists; none for a list that does not say which (a widened array), so nothing reads as loaded that was not. */
export type {{ loadable.namesName }}<L extends readonly (keyof {{ loadable.name }})[]> = number extends L["length"] ? never : L[number];

/** The `load` member of a read called with the tuple `L`: required when `L` lists a name, so an input cannot claim a load it does not make. */
export type {{ loadable.argName }}<L extends readonly (keyof {{ loadable.name }})[]> = [{{ loadable.namesName }}<L>] extends [never] ? { load?: L | undefined } : { load: L };

/** A {{ record.name }} as the functions of its entity file see it: every relationship and computed field present, and each related record the same. */
export type {{ loadable.loadedName }} = {{ record.name }} & {
  @each(member in loadable.loadedMembers)
  {{ member.key }}: {{ member.type }};
  @end
};

@end
@if(query)
export type {{ query.filterName }} =
  | { and: readonly {{ query.filterName }}[] }
  | { or: readonly {{ query.filterName }}[] }
  | {
      @each(member in query.filterMembers)
      {{ member.key }}?: {{ member.type }};
      @end
    };

export type {{ query.sortName }} = readonly (
  @each(key in query.sortKeys)
  | {{ key }}
  @end
)[];
@end
