// Do not edit this file by hand.
// It is generated by `mesh build` from src/domain/work/work.mesh.mx; change that file and rebuild.
// The input type of each operation of the service, and the Zod schema that casts it.

import { z } from "zod";
import { jsonValue as $jsonValue } from "@meshfw/runtime";
import { $Date } from "../../$globals";

type Keys<T> = T extends { [key: string]: never } ? never : keyof T;

type SameShape<A, B> = [Keys<A>] extends [Keys<B>]
  ? [Keys<B>] extends [Keys<A>]
    ? [A] extends [B]
      ? [B] extends [A]
        ? true
        : false
      : false
    : false
  : false;

type Assert<T extends true> = T;

/**
 * Marks the issues of the Mesh file's line rules (`min`, `max`, `match`) with `meshRule: { code, source }`, which
 * `@meshfw/runtime` reads: Zod's own issue code and a top-level field name pick the rule. Zod's safe-integer range check
 * of `z.int()` (origin `int`) is no line rule and stays unmarked. Returns the same schema, its type unchanged.
 */
type $Rules = {
  readonly [field: string]: {
    readonly [zodCode: string]: {
      code: string;
      source: { file: string; line: number; column: number };
    };
  };
};
const $ruled = <S extends z.ZodType>(schema: S, rules: $Rules): S => {
  const standard = schema["~standard"];
  const mark = <R extends { readonly issues?: readonly unknown[] | undefined }>(result: R): R =>
    result.issues
      ? ({
          issues: result.issues.map((issue) => {
            const raw = issue as {
              path?: readonly unknown[];
              code?: string;
              format?: string;
              origin?: string;
            };
            const key = raw.path?.length === 1 ? raw.path[0] : undefined;
            const field = typeof key === "string" ? key : undefined;
            const zod =
              raw.code === "invalid_format" && raw.format === "regex" ? "regex" : raw.code;
            const rule =
              field === undefined || raw.origin === "int" || zod === undefined
                ? undefined
                : rules[field]?.[zod];
            return rule ? { ...raw, meshRule: rule } : issue;
          }),
        } as unknown as R)
      : result;
  schema["~standard"] = {
    ...standard,
    validate: (value: unknown) => {
      const result = standard.validate(value);
      return "then" in result ? result.then(mark) : mark(result);
    },
  } as typeof standard;
  return schema;
};

export type HandOverWorkInput = {
  task: string;
  to: string;
  reason?: string | null | undefined;
};

export const handOverWorkInputSchema = z.strictObject({
  task: z.uuid(),
  to: z.uuid(),
  reason: z.string().nullable().optional(),
}) satisfies z.ZodType<HandOverWorkInput>;

export type HandOverWorkInputShape = Assert<
  SameShape<z.output<typeof handOverWorkInputSchema>, HandOverWorkInput>
>;

export type NotifyWorkInput = {
  text: string;
  meta?: unknown | undefined;
  on?: $Date | null | undefined;
};

export const notifyWorkInputSchema = $ruled(
  z.strictObject({
    text: z.string().min(1, "must be at least 1 character"),
    meta: (z.unknown().transform($jsonValue) as z.ZodType<unknown>).nullable().optional(),
    on: z.date().nullable().optional(),
  }),
  {
    text: {
      too_small: {
        code: "too_short",
        source: { file: "src/domain/work/work.mesh.mx", line: 25, column: 7 },
      },
    },
  },
) satisfies z.ZodType<NotifyWorkInput>;

export type NotifyWorkInputShape = Assert<
  SameShape<z.output<typeof notifyWorkInputSchema>, NotifyWorkInput>
>;

export type CancelRunWorkInput = {
  run: string;
};

export const cancelRunWorkInputSchema = z.strictObject({
  run: z.uuid(),
}) satisfies z.ZodType<CancelRunWorkInput>;

export type CancelRunWorkInputShape = Assert<
  SameShape<z.output<typeof cancelRunWorkInputSchema>, CancelRunWorkInput>
>;

export type FinishWorkInput = {
  task: string;
};

export const finishWorkInputSchema = z.strictObject({
  task: z.uuid(),
}) satisfies z.ZodType<FinishWorkInput>;

export type FinishWorkInputShape = Assert<
  SameShape<z.output<typeof finishWorkInputSchema>, FinishWorkInput>
>;
