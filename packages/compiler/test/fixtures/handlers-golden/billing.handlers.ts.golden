// It is generated by `mesh build` from domain/billing/billing.mesh.mx; change that file and rebuild.
// The handlers of the `handlers` section of billing.Billing, by kind and key: the generated `bind` merges them with the other
// owners' (`mergeHandlers`) and hands them to `bindDomain`, which registers them beside the events module's. Mesh's own
// names carry a `$`, so the helpers the file imports keep the names it gives them.

import {
  handler as $handler,
  type ActionContext as $ActionContext,
  type EventRecord as $EventRecord,
  type SectionHandlers as $SectionHandlers,
} from "@meshfw/runtime";
import {
  Invoice as $billing$Invoice$value,
  type $ReadOnly as $billing$Invoice$ReadOnly,
} from "./invoice.actions";
import { BillingClosed as $billing$BillingClosed$class } from "./billingClosed.event";
import { InvoicePaid as $billing$InvoicePaid$class } from "./invoicePaid.event";

/** What a handler body reads: the event, one of those its `on=` lists, and the context it runs with. */
type $HandlerScope<E extends object> = {
  readonly event: $EventRecord<E>;
  readonly context: $ActionContext;
};

export const $handlers: $SectionHandlers = {
  process: {
    // process :close (domain/billing/billing.mesh.mx:10:5)
    "billing.Billing.close": $handler({
      events: [$billing$InvoicePaid$class, $billing$BillingClosed$class],
      run: async (event, { context }) => {
        await (($s: $HandlerScope<$billing$InvoicePaid$class | $billing$BillingClosed$class>) => {
          const Invoice: $billing$Invoice$ReadOnly = $billing$Invoice$value;
          return (async function ({ event, context }) {
            return Invoice.markReceiptSent({ id: event.payload.invoiceId }, context);
          })($s);
        })({ event, context });
      },
    }),
  },
  listen: {},
  at: {
    "billing.Billing.close": "domain/billing/billing.mesh.mx:10:5",
  },
};
