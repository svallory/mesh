  Mesh,
  type ActionContext as $ActionContext,
  type EventRecord as $EventRecord,
  type SectionHandlers as $SectionHandlers,
} from "@meshfw/runtime";
import { type Note, sendReceipt as mail } from "../../../domain/billing/mailer";
import {
  Invoice as $billing$Invoice$value,
  type $ReadOnly as $billing$Invoice$ReadOnly,
  type Invoice as $billing$Invoice$Record,
} from "./invoice.actions";
import { InvoicePaid as $billing$InvoicePaid$class } from "./invoicePaid.event";
import { InvoiceVoided as $billing$InvoiceVoided$class } from "./invoiceVoided.event";

/** What a handler body reads: the event, one of those its `on=` lists, and the context it runs with. */
type $HandlerScope<E extends object> = {
  readonly event: $EventRecord<E>;
  readonly context: $ActionContext;
};

export const $handlers: $SectionHandlers = {
  process: {
    // process :voided (domain/billing/invoice.mesh.mx:34:5)
    "billing.Invoice.voided": $handler({
      events: [$billing$InvoiceVoided$class, $billing$InvoicePaid$class],
      run: async (event, { context }) => {
        await (($s: $HandlerScope<$billing$InvoiceVoided$class | $billing$InvoicePaid$class>) => {
          const Invoice: $billing$Invoice$ReadOnly = $billing$Invoice$value;
          type Invoice = $billing$Invoice$Record;
          return (async function ({ event, context }) {
            const note: Note = { text: event.name };
            const before: Invoice | null = null;
            return Invoice.markReceiptSent(
              { id: event.payload.invoiceId },
              { ...context, system: Mesh.isSystem(context) || note.text !== "" || before === null },
            );
          })($s);
        })({ event, context });
      },
    }),
  },
  listen: {
    // listen :receipt (domain/billing/invoice.mesh.mx:30:5)
