      events: [$billing$InvoicePaid$class],
      run: async (event, { context }) => {
        await (($s: $HandlerScope<$billing$InvoicePaid$class>) => {
          const Invoice: $billing$Invoice$ReadOnly = $billing$Invoice$value;
          return (async function async({ event, context }) {
            await mail({ idempotencyKey: event.id, invoiceId: event.payload.invoiceId });
            await Invoice.markReceiptSent({ id: event.payload.invoiceId }, context);
          })($s);
        })({ event, context });
      },
      renamedFrom: "billing.Invoice.mailReceipt",
    }),
