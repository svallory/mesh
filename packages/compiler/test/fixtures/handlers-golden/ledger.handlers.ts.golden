// Do not edit this file by hand.
// It is generated by `mesh build` from domain/billing/ledger.mesh.mx; change that file and rebuild.
// The handlers of the `handlers` section of billing.Ledger, by kind and key: the generated `bind` merges them with the other
// owners' (`mergeHandlers`) and hands them to `bindDomain`, which registers them beside the events module's. Mesh's own
// names carry a `$`, so the helpers the file imports keep the names it gives them.

import {
  handler as $handler,
  type ActionContext as $ActionContext,
  type EventRecord as $EventRecord,
  type SectionHandlers as $SectionHandlers,
} from "@meshfw/runtime";
import { sendReceipt } from "../../../domain/billing/mailer";
import { InvoicePaid as $billing$InvoicePaid$class } from "./invoicePaid.event";
import { PaymentRecorded as $billing$PaymentRecorded$class } from "./paymentRecorded.event";

/** What a handler body reads: the event, one of those its `on=` lists, and the context it runs with. */
type $HandlerScope<E extends object> = {
  readonly event: $EventRecord<E>;
  readonly context: $ActionContext;
};

export const $handlers: $SectionHandlers = {
  process: {},
  listen: {
    // listen :receipt (domain/billing/ledger.mesh.mx:9:5)
    "billing.Ledger.receipt": $handler({
      events: [$billing$InvoicePaid$class, $billing$PaymentRecorded$class],
      run: async (event, { context }) => {
        await (($s: $HandlerScope<$billing$InvoicePaid$class | $billing$PaymentRecorded$class>) => {
          return (async ({ event }) => {
            await sendReceipt({ idempotencyKey: event.id, invoiceId: event.payload.invoiceId });
          })($s);
        })({ event, context });
      },
    }),
    // listen :total (domain/billing/ledger.mesh.mx:10:5)
    "billing.Ledger.total": $handler({
      events: [$billing$PaymentRecorded$class],
      run: async (event, { context }) => {
        await (($s: $HandlerScope<$billing$PaymentRecorded$class>) => {
          const { event } = $s;
          return (async function async() {
            const amount: number = event.payload.amount;
            await sendReceipt({ idempotencyKey: `${amount}`, invoiceId: event.payload.invoiceId });
          })();
        })({ event, context });
      },
    }),
  },
  at: {
    "billing.Ledger.receipt": "domain/billing/ledger.mesh.mx:9:5",
    "billing.Ledger.total": "domain/billing/ledger.mesh.mx:10:5",
  },
};
