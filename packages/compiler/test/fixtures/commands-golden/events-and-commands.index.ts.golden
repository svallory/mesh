// The commands an action answers (`on=`): `dispatch(command, context)` runs the action, and joins the running transaction.
import { Invoice as $billing$Invoice$value } from "./domain/billing/invoice.actions";
import type { PayInvoice as $billing$PayInvoice$class } from "./domain/billing/payInvoice.command";
import {
  dispatchCommand as $dispatchCommand,
  type ActionContext as $ActionContext,
  type ActionResult as $ActionResult,
  type CommandAction as $CommandAction,
} from "@meshfw/runtime";

/** The instance type of every command class an action answers: what `dispatch` takes. */
export type DomainCommand = $billing$PayInvoice$class;
/** What `dispatch` resolves with: what the action that answers the command returns. */
export type DispatchResult<C extends DomainCommand> = C extends $billing$PayInvoice$class
  ? $ActionResult<typeof $billing$Invoice$value.payInvoice>
  : never;

const $commandActions: { readonly [fqn: string]: $CommandAction } = {
  "billing.PayInvoice": {
    run: (command: $billing$PayInvoice$class, context) =>
      $billing$Invoice$value.payInvoice({ id: command.id, paidAt: command.paidAt }, context),
  },
};

/**
 * Runs the action whose `on=` names the command's class, with the command's fields as its input and the `context` given.
 * Inside a transaction (an action's, a `process` handler's, `transaction()`'s) the action joins it; outside, it opens its own.
 * Resolves with what the action returns, and rejects with what it throws.
 */
export function dispatch<C extends DomainCommand>(
  command: C,
  context: $ActionContext,
): $Promise<DispatchResult<C>> {
  return $dispatchCommand($commandActions, command, context) as $Promise<DispatchResult<C>>;
}
