import { z } from "zod";
import { $RegExp } from "../$globals";

/** The concept Money: a value with no identity, replaced whole. */
export type Money = {
  readonly currency: string;
  readonly amount: number;
};

/** Checks a Money: exactly its fields, each against its declaration. */
export const moneySchema = z.strictObject({
  currency: z.string().regex(new $RegExp("^[A-Z]{3}$", ""), "must match /^[A-Z]{3}$/"),
  amount: z.int().min(0, "must be at least 0"),
}) satisfies z.ZodType<Money>;
