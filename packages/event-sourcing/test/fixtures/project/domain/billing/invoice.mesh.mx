import { InvoicePaid } from "./invoice-paid.mesh.mx"
import { InvoiceVoided } from "./invoice-voided.mesh.mx"

entity :Invoice
  attributes
    uuid :id primary-key
    boolean :paid default=false
  actions auto=[:read]
    create :open
    update :pay
      do
        set
          &paid=true
        publish=() => new InvoicePaid({ invoiceId: &id })
    update :void
      do
        publish=() => new InvoiceVoided({ invoiceId: &id })
  policies
    policy :anyone types=[:create, :read, :update]
      authorize-if=() => true
