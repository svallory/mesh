// Do not edit this file by hand.
// It is generated by `mesh build` from the entity files; change them and rebuild.

import {
  sqliteTable as _meshSqlite,
  @each(builder in builders)
  {{ builder }},
  @end
} from "drizzle-orm/sqlite-core";

@each(table in tables)
export const {{ table.exportName }} = _meshSqlite({{ table.nameLiteral }}, {
  @each(column in table.columns)
  @if(column.options)~
  {{ column.key }}: {{ column.builder }}({{ column.nameLiteral }}, {{ column.options }})
  @else~
  {{ column.key }}: {{ column.builder }}({{ column.nameLiteral }})
  @end~
  @if(column.notNull)~
    .notNull()
  @end~
  @if(column.primaryKey)~
    .primaryKey()
  @end~
  ,
  @end
});

@end
export const tables = {
  @each(table in tables)
  {{ table.key }}: {{ table.exportName }},
  @end
};
