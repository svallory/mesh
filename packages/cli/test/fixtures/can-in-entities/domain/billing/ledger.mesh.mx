import { Mesh as M } from "meshfw"
import { Receipt } from "./receipt.mesh.mx"
import { askLoudly, askQuietly, remember } from "./probe"

entity :Ledger
  attributes
    uuid :id primary-key
    string :name
    uuid :invoiceId

  computed
    boolean :covered() { return askQuietly({}) }

  actions auto=[:read]
    create :add
      input
        &name
        &invoiceId

    update :rename
      input
        &name

    update :audit
      do
        run async ({ self, context }) {
          remember({ step: "audit", allowed: await M.can(Receipt.record, { invoiceId: self.invoiceId, amount: 1, at: new Date(0) }, { ...context, system: true }) })
        }

  policies
    policy :adding types=[:create]
      authorize-if=() => true
    policy :looking types=[:read]
      authorize-if=({ context }) => askQuietly(context)
    policy :renaming actions=[&rename]
      authorize-if=async ({ self, context }) => await askLoudly(context, self.invoiceId)
    policy :auditing actions=[&audit]
      authorize-if=() => true
