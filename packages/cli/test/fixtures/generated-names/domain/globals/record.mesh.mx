import { Date as structuredClone } from "./date.mesh.mx"
import { Pick } from "./pick.mesh.mx"

entity :Record
  attributes
    uuid :id primary-key
    string :name min=1 max=40 match=/^[A-Z]/
    integer :counted nullable
  relationships
    belongs-to :next entity=Pick nullable
  computed
    integer :size() { return &name.length }
  actions auto=[:read]
    create :create
      input
        &name
        &next
    update :rename
      input
        &name
      validate
        check :long that=({ input }) => input.name === null || input.name.length > 3 code="short" message="The name is too short"
    update :count
      do
        set
          &counted=async () => (await structuredClone.read({}, { actor: { id: "counter" } })).length
  policies
    policy :anyone types=[:create, :read, :update]
      authorize-if=() => true
    policy :keeper actions=[&rename]
      forbid-if=({ actor }) => actor.id === "intruder"
