import { Map } from "./map.mesh.mx"

entity :RegExp
  attributes
    uuid :id primary-key
    string :name min=1 max=40 match=/^[A-Z]/
  relationships
    belongs-to :next entity=Map nullable
  computed
    boolean :matches() { return /^[A-Z]/.test(&name) }
  actions auto=[:read]
    create :create
      input
        &name
        &next
    update :rename
      input
        &name
      validate
        check :long that=({ input }) => input.name === null || input.name.length > 3 code="short" message="The name is too short"
  policies
    policy :anyone types=[:create, :read, :update]
      authorize-if=() => true
    policy :keeper actions=[&rename]
      forbid-if=({ actor }) => actor.id === "intruder"
