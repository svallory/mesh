import { List } from "./list.mesh.mx"
import { Mesh } from "meshfw"

entity :Todo table="todos"
  attributes
    uuid :id primary-key
    string :title min=1
    boolean :done default=false
    timestamp :insertedAt on=:create
    timestamp :updatedAt on=:update

  relationships
    belongs-to :list entity=List

  computed
    string :label() {
      return (&done ? "[x] " : "[ ] ") + &title
    }

  actions auto=[:read, :destroy]
    create :create
      input
        &title
        &list

    update :complete
      validate
        check :notDoneYet [
          that=() => !&done
          code="already_done"
          message="this todo is already complete"
        ]
      do
        set
          &done=true

    update :rename
      input
        &title

    read :pending
      filter=() => &done === false
      sort
        asc &insertedAt

  policies
    policy :owner types=[:update, :destroy]
      authorize-if=({ actor }) => &list.ownerId === actor.id
    policy :signedIn types=[:read]
      authorize-if=({ actor }) => actor.id !== null
    policy :ownerCreates types=[:create]
      authorize-if=async ({ input, actor }) => {
        const [list] = await Mesh.privileged(List).read({ filter: { id: { eq: input.list } } })
        return list?.ownerId === actor.id
      }
