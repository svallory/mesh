import { descend, ping, readCatching, recurse, spawnCatching, recurseName, recurseOk, twiceCatching } from "./probe"

entity :Node
  attributes
    uuid :id primary-key
    string :name
    boolean :touched default=false
    uuid :parentId nullable

  actions auto=[:read]
    create :add
      input
        &name
        &parentId

    update :reparent
      input
        &parentId

    update :climb
      do
        set
          &touched=true
        run async ({ self }) {
          if (self.parentId !== null) await recurse("climb", self.parentId)
        }

    update :gate
      do
        set
          &touched=true

    update :named
      input
        &name
      do
        set
          &name=async () => await recurseName("named")

    update :looped
      validate
        check :loop that=async () => await recurseOk("looped") code="loop" message="loops"
      do
        set
          &touched=true

    update :wrap
      do
        set
          &touched=true
        run async () {
          await recurse("wrap")
        }

    update :twice
      do
        set
          &touched=true
        run async ({ self }) {
          await twiceCatching(self.id)
        }

    update :start
      do
        run async ({ self }) {
          await recurse("climb", self.id)
        }

    update :afterFailure
      do
        run async () {
          try {
            await recurse("fail")
          } catch {
            // the transaction is failed all the same (TXN-01)
          }
          await recurse("count")
        }

    create :spawn
      input
        &name
        &parentId
      do
        run [after=:write] async () {
          await spawnCatching("spawn", 1)
        }

    create :spawnTwice
      input
        &name
        &parentId
      do
        run [after=:write] async () {
          await spawnCatching("spawnTwice", 2)
        }

    create :descend
      input
        &name
        &parentId
      do
        run [after=:write] async () {
          await descend()
        }

    update :probed
      do
        set
          &touched=true

    update :plainStep
      do
        set
          &touched=true

    update :seamed
      do
        set
          &touched=true

    update :fail
      do
        run async () {
          throw new Error("fails on purpose")
        }

    update :count
      do
        run async () {
          ping()
        }

  policies
    policy :adding types=[:create]
      authorize-if=() => true
    policy :everyone types=[:read]
      authorize-if=() => true
    policy :open actions=[&reparent, &climb, &named, &looped, &wrap, &twice, &start, &afterFailure, &seamed, &plainStep, &fail, &count]
      authorize-if=() => true
    policy :gating actions=[&gate]
      authorize-if=async ({ self }) => { await recurse("gate", self.id); return true }
    policy :probing actions=[&probed]
      authorize-if=async () => { await readCatching(); return true }
