import { seen } from "./probe"

entity :Note
  attributes
    uuid :id primary-key
    string :title
    boolean :translatedInSet default=false
    boolean :plainInSet default=false
    integer :count default=7
    integer :copied default=-1

  actions auto=[:read]
    create :make
      input
        &title
      do
        set
          &translatedInSet=({ before }) => before === null
          &plainInSet=({ before }) => { return before === null }
          &copied=({ before }) => before !== null ? before.count : 0
        run () { seen.free.push(before) }
        run ({ before }) { seen.destructured.push(before) }

    update :rename
      input
        &title
      do
        set
          &copied=({ before }) => before !== null ? before.count : 0
        run ({ before }) { seen.updated.push(before === null ? null : before.title) }

  policies
    policy :open types=[:create, :read, :update]
      authorize-if=() => true
