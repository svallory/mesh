import { Mesh } from "meshfw"
import { Note } from "./note.mesh.mx"
import { dueIn, stampOf } from "./clock"

entity :Task
  attributes
    uuid :id primary-key
    string :title min=1
    timestamp :dueAt nullable
    timestamp :closedAt nullable
  computed
    boolean :overdue() { return &dueAt < %.now }
    integer :daysLeft() { const due = &dueAt; return due === null ? null : Math.floor((due.getTime() - %.today.getTime()) / 86400000) }
  actions auto=[:read]
    create :open
      input
        &title
        &dueAt
      validate
        check :notPast that=({ input, context }) => Mesh.isSystem(context) || input.dueAt === null || input.dueAt >= %.today code="past" message="A task is not due in the past"
    update :close
      do
        set
          &closedAt=() => %.now
        run [after=:write] async ({ self, context }) {
          const notes = await Mesh.privileged(Note).read({ load: ["stamp"] })
          await Note.write({ text: `${self.title} closed at ${%.now.toISOString()} after ${notes.length} notes stamped ${notes.map((note) => note.stamp).join(",")}` }, context)
        }
    update :touch
      do
        set
          &dueAt=() => dueIn(%.today, 30)
    update :mark
      do
        run [after=:write] async ({ self, context }) {
          const by = Mesh.isSystem(context) ? "the system" : "a person"
          await Note.write({ text: `${stampOf(%.now, self.title)} by ${by}` }, context)
        }
  policies
    policy :anyone types=[:create, :read]
      authorize-if=() => true
    policy :closer types=[:update]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.id === "owner"
