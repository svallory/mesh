import { InvoicePaid } from "./invoice-paid.mesh.mx"
import { InvoiceOpened } from "./invoice_opened.mesh.mx"
import { InvoiceVoided } from "./invoice_voided.mesh.mx"
import * as refunds from "../sales/refunds/refund-issued.mesh.mx"
import { made, step } from "./probe"

entity :Invoice
  attributes
    uuid :id primary-key
    boolean :paid default=false
    decimal :total default=10
  actions auto=[:read]
    create :open
      do
        publish=() => new InvoiceOpened({ invoiceId: &id })
    destroy :void
      do
        publish=() => new InvoiceVoided({ invoiceId: &id, total: &total })
    update :pay
      do
        set
          &paid=true
        publish=() => new InvoicePaid({ invoiceId: &id, amount: &total, reference: null, method: "card", paidAt: %.now, extra: { by: "test" } })
    update :refund
      do
        when=() => &paid
          publish=async () => {
            if (&total < 5) return new refunds.RefundIssued({ invoiceId: &id, cents: 1 })
            return new refunds.RefundIssued({ invoiceId: &id, cents: 500 })
          }
    update :publishMade
      do
        publish=() => made()
    update :chain
      do
        set
          &paid=true
        publish=() => new InvoicePaid({ invoiceId: &id, amount: &total, method: "wire", paidAt: %.now, extra: null })
        run [after=:write] async ({ self }) {
          await step("chain", self.id)
        }
        publish=() => new refunds.RefundIssued({ invoiceId: &id, cents: 2 })
  policies
    policy :anyone types=[:create, :read, :update, :destroy]
      authorize-if=() => true
