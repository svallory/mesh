{
  "name": "meshfw",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Mesh build-time developer command",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "mesh": "./src/bin.ts"
  },
  "mx": {
    "dialect": {
      "id": "mesh",
      "name": "Mesh",
      "extensions": [
        ".mesh.mx"
      ],
      "module": "./dist/dialect.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build-dialect.ts"
  },
  "dependencies": {
    "@meshfw/compiler": "workspace:*",
    "@meshfw/model": "workspace:*",
    "@meshfw/runtime": "workspace:*"
  },
  "files": [
    "src",
    "!src/dialect.ts",
    "dist"
  ]
}
