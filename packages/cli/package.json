{
  "name": "meshfw",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Mesh build-time developer command",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "mesh": "./src/bin.ts"
  },
  "mx": {
    "dialect": {
      "id": "mesh",
      "name": "Mesh",
      "extensions": [
        ".mesh.mx"
      ],
      "module": "./dist/dialect.js",
      "mxConfigTags": false,
      "tagDirs": [],
      "reservedTags": [
        "entity",
        "attributes",
        "relationships",
        "computed",
        "actions",
        "always",
        "input",
        "validate",
        "check",
        "do",
        "set",
        "when",
        "load",
        "run",
        "filter",
        "sort",
        "policies",
        "policy",
        "authorize-if",
        "forbid-if",
        "uuid",
        "string",
        "integer",
        "float",
        "decimal",
        "boolean",
        "enum",
        "date",
        "datetime",
        "timestamp",
        "json",
        "belongs-to",
        "has-many",
        "has-one",
        "create",
        "read",
        "update",
        "destroy",
        "count",
        "sum",
        "avg",
        "min",
        "max",
        "asc",
        "desc"
      ]
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build-dialect.ts",
    "prepare": "bun scripts/build-dialect.ts"
  },
  "dependencies": {
    "@meshfw/compiler": "workspace:*",
    "@meshfw/model": "workspace:*",
    "@meshfw/runtime": "workspace:*"
  },
  "files": [
    "src",
    "!src/dialect.ts",
    "dist"
  ]
}
