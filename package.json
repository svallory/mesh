{
  "name": "mesh",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["packages/*", "apps/*", "examples/*"],
  "scripts": {
    "test": "bun run --filter '*' test",
    "test:affected": "bun scripts/test-affected.ts",
    "test:fast": "bun scripts/test-affected.ts --all",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "verify": "bun scripts/verify.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
