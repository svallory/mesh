import { User } from "./user.mesh.mx"
import { Comment } from "./comment.mesh.mx"

// self.x remains legal until MX lang-ext-syntax-table supplies & in expressions.
entity :Post table="posts"
  attributes
    uuid :id primary-key
    string :title min=1 max=200
    string :body nullable
    integer :views default=0 min=0
    float :rating nullable
    decimal :price default=0
    boolean :featured default=false
    date :publicationDate nullable
    datetime :publishedAt nullable
    enum :state values=[:draft, :published] default=:draft
    timestamp :insertedAt on=:create
    timestamp :updatedAt on=:update

  relationships
    belongs-to :author entity=User
    has-many :comments entity=Comment

  computed
    string :excerpt({ self }) { return (self.body ?? "").slice(0, 200) }
    count :commentCount of="comments"

  actions auto=[:read, :destroy]
    create :create
      input
        &title
        &body
        &author
    update :publish
      validate
        check :titlePresent that=({ self }) => self.title.length > 0 code="title_required" message="Title is required"
      do
        set
          &state=:published
    destroy :archive
    read :published
      filter=({ self }) => self.state === :published

  policies
    policy :public types=[:read]
      authorize-if=({ self }) => self.state === :published
    policy :owner types=[:update, :destroy]
      authorize-if=({ self, actor }) => self.author.id === actor.id
