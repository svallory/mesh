import { Machine } from "./machine.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { machineActiveOf } from "./execution.helpers"

entity :SessionReference table="session_references"
  attributes
    uuid :id primary-key
    string :runtime
    string :runtimeSessionId
    enum :availability values=[:complete, :partial, :unavailable, :redacted]
    string :location nullable
    integer :version default=1
    timestamp :recordedAt on=:create
  relationships
    belongs-to :machine entity=Machine
    belongs-to :agentProfile entity=Collaborator
    belongs-to :recordedBy entity=Collaborator
  actions auto=[:read]
    create :record
      input
        &runtime
        &runtimeSessionId
        &availability
        &location
        &machine
        &agentProfile
      validate
        check :agentProfile [
          that=async ({ input, tx }) => (await tx.readCollaborator({ filter: { id: { eq: input.agentProfile } }, limit: 1 })).length > 0
          code="session.agent-profile"
          message="the agent profile is not a collaborator"
        ]
        check :machineRetired [
          that=({ input, tx }) => machineActiveOf(tx, input.machine)
          code="machine.retired"
          message="the machine is retired; report the host by a new name"
        ]
      do
        set
          &recordedBy=({ actor }) => actor.id
    update :setAvailability
      input
        &availability
        &location
        string :reason nullable
        integer :expectedVersion nullable
      validate
        check :notRedacted [
          that=() => &availability !== :redacted
          code="session.not-redacted"
          message="the session is redacted and cannot be changed"
        ]
        check :availabilityKept [
          that=({ input }) => (input.availability ?? &availability) !== :redacted
          code="session.availability"
          message="availability is complete, partial or unavailable; redact with redact"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
    update :redact
      input
        string :reason min=1
        integer :expectedVersion nullable
      validate
        check :notRedacted [
          that=() => &availability !== :redacted
          code="session.not-redacted"
          message="the session is redacted and cannot be changed"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &availability=:redacted
          &location=null
          &version=() => &version + 1
