import { Machine } from "./machine.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { machineActiveOf } from "./execution.helpers"
import { memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :SessionReference table="session_references"
  attributes
    uuid :id primary-key
    string :runtime
    string :runtimeSessionId
    enum :availability values=[:complete, :partial, :unavailable, :redacted]
    string :location nullable
    integer :version default=1
    timestamp :recordedAt on=:create
  relationships
    belongs-to :machine entity=Machine
    belongs-to :agentProfile entity=Collaborator
    belongs-to :recordedBy entity=Collaborator
  checks
    check :notRedacted [
      that=() => &availability !== :redacted
      code="session.not-redacted"
      message="the session is redacted and cannot be changed"
    ]
  actions auto=[:read]
    create :record
      input
        &runtime
        &runtimeSessionId
        &availability
        &location
        &machine
        &agentProfile
      validate
        check :agentProfileExists [
          that=async ({ input }) => (await Mesh.privileged(Collaborator).read({ filter: { id: { eq: input.agentProfile } }, limit: 1 })).length > 0
          code="session.agent-profile"
          message="the agent profile is not a collaborator"
        ]
        check :machineRetired [
          that=async ({ input }) => await machineActiveOf(input.machine)
          code="machine.retired"
          message="the machine is retired; report the host by a new name"
        ]
      do
        set
          &recordedBy=({ actor }) => actor.id
    update :setAvailability
      input
        &availability
        &location
        string :reason nullable
      validate
        check &notRedacted
        check :availabilityKept [
          that=({ input }) => (input.availability ?? &availability) !== :redacted
          code="session.availability"
          message="availability is complete, partial or unavailable; redact with redact"
        ]
      do
        lock &version optional
    update :redact
      input
        string :reason min=1
      validate
        check &notRedacted
      do
        lock &version optional
        set
          &availability=:redacted
          &location=null
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&record, &redact]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&record]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
    policy :ownerOnly actions=[&redact]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner])
    policy :sessionRecorder actions=[&setAvailability]
      authorize-if=({ self, actor, context }) => Mesh.isSystem(context) || self.recordedById === actor.id
