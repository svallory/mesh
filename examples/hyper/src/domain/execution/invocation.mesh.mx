import { Attempt } from "./attempt.mesh.mx"
import { Task } from "../work/task.mesh.mx"
import { SessionReference } from "./session-reference.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { attemptSessionOf, correctsInvocationOf, performsAttemptOf } from "./execution.helpers"
import { memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :Invocation table="invocations"
  attributes
    uuid :id primary-key
    string :requestedProvider nullable
    string :requestedModel nullable
    string :actualProvider nullable
    string :actualModel nullable
    integer :inputTokens nullable min=0
    integer :outputTokens nullable min=0
    integer :cacheReadTokens nullable min=0
    integer :cacheWriteTokens nullable min=0
    enum :usageSource values=[:runtime, :provider, :estimate]
    decimal :estimatedCost nullable
    string :pricingBasis nullable
    timestamp :startedAt nullable
    timestamp :endedAt nullable
    string :reason nullable
    timestamp :recordedAt on=:create
  relationships
    belongs-to :attempt entity=Attempt
    belongs-to :task entity=Task
    belongs-to :session entity=SessionReference nullable
    belongs-to :corrects entity=Invocation nullable
    belongs-to :recordedBy entity=Collaborator
  actions auto=[:read]
    create :record
      input
        &attempt
        &requestedProvider
        &requestedModel
        &actualProvider
        &actualModel
        &inputTokens
        &outputTokens
        &cacheReadTokens
        &cacheWriteTokens
        &usageSource
        &estimatedCost
        &pricingBasis
        &startedAt
        &endedAt
        &session
      validate
        check :session [
          that=async ({ input }) => input.session == null || input.session === await attemptSessionOf(input.attempt)
          code="invocation.session"
          message="the session is not the attempt's session"
        ]
        check :costUnknown [
          that=({ input }) => (input.inputTokens !== null && input.outputTokens !== null) || input.estimatedCost === null
          code="invocation.cost-unknown"
          message="the cost is unknown while a token count it needs is unknown"
        ]
      do
        set
          &task=() => &attempt.taskId
          &recordedBy=({ actor }) => actor.id
    create :correct
      input
        &corrects
        &reason
        &requestedProvider
        &requestedModel
        &actualProvider
        &actualModel
        &inputTokens
        &outputTokens
        &cacheReadTokens
        &cacheWriteTokens
        &usageSource
        &estimatedCost
        &pricingBasis
        &startedAt
        &endedAt
        &session
      validate
        check :notCorrected [
          that=async ({ input }) => input.corrects != null && (await Mesh.privileged(Invocation).read({ filter: { correctsId: { eq: input.corrects } }, limit: 1 })).length === 0
          code="invocation.not-corrected"
          message="the invocation is already corrected"
        ]
        check :reason [
          that=({ input }) => (input.reason ?? "") !== ""
          code="invocation.reason"
          message="a correction gives a reason"
        ]
        check :costUnknown [
          that=({ input }) => (input.inputTokens !== null && input.outputTokens !== null) || input.estimatedCost === null
          code="invocation.cost-unknown"
          message="the cost is unknown while a token count it needs is unknown"
        ]
      do
        set
          &attempt=async ({ input }) => (await Mesh.privileged(Invocation).read({ filter: { id: { eq: input.corrects ?? "" } } })).map((corrected) => corrected.attemptId)[0]
          &task=async ({ input }) => (await Mesh.privileged(Invocation).read({ filter: { id: { eq: input.corrects ?? "" } } })).map((corrected) => corrected.taskId)[0]
          &recordedBy=({ actor }) => actor.id
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&record, &correct]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&record, &correct]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
    policy :attemptPerformer actions=[&record]
      authorize-if=async ({ input, actor, context }) => Mesh.isSystem(context) || await performsAttemptOf(input.attempt, actor.id)
    policy :invocationRecorder actions=[&correct]
      authorize-if=async ({ input, actor, context }) => Mesh.isSystem(context) || await correctsInvocationOf(input.corrects, actor.id)
