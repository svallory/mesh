import { Collaborator } from "../identity/collaborator.mesh.mx"
import { Attempt } from "./attempt.mesh.mx"
import { memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :Machine table="machines"
  attributes
    uuid :id primary-key
    string :name unique
    string :platform nullable
    enum :state values=[:active, :retired] default=:active
    integer :version default=1
    timestamp :registeredAt on=:create
  relationships
    belongs-to :firstReportedBy entity=Collaborator nullable
    has-many :attempts entity=Attempt
  checks
    check :nameFree [
      that=async ({ input }) => (await Mesh.privileged(Machine).read({ filter: { name: { eq: input.name } }, limit: 1 })).length === 0
      code="machine.name-free"
      message="a machine already has that name"
    ]
    check :machineActive [
      that=() => &state === :active
      code="machine.active"
      message="the machine is retired"
    ]
  actions auto=[:read]
    create :register
      input
        &name
        &platform
      validate
        check &nameFree
      do
        set
          &firstReportedBy=({ actor }) => actor.id
    create :report
      input
        &name
      validate
        check &nameFree
      do
        set
          &firstReportedBy=({ actor }) => actor.id
    update :update
      input
        &platform
      validate
        check &machineActive
      do
        lock &version optional
    update :retire
      input
        string :reason min=1
      validate
        check &machineActive
        check :machineIdle [
          that=() => !&attempts.some((a) => a.state === :running)
          code="machine.idle"
          message="an attempt on this machine is reported running"
        ]
      do
        lock &version optional
        set
          &state=:retired
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&register, &update, &retire]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&register]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
    policy :ownerOnly actions=[&update, &retire]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner])
    policy :internal actions=[&report]
      authorize-if=({ context }) => Mesh.isSystem(context)
