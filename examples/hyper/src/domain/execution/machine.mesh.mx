import { Collaborator } from "../identity/collaborator.mesh.mx"
import { Attempt } from "./attempt.mesh.mx"

entity :Machine table="machines"
  attributes
    uuid :id primary-key
    string :name unique
    string :platform nullable
    enum :state values=[:active, :retired] default=:active
    integer :version default=1
    timestamp :registeredAt on=:create
  relationships
    belongs-to :firstReportedBy entity=Collaborator nullable
    has-many :attempts entity=Attempt
  actions auto=[:read]
    create :register
      input
        &name
        &platform
      validate
        check :nameFree [
          that=async ({ input, tx }) => (await tx.readMachine({ filter: { name: { eq: input.name } }, limit: 1 })).length === 0
          code="machine.name-free"
          message="a machine already has that name"
        ]
      do
        set
          &firstReportedBy=({ actor }) => actor.id
    create :report
      input
        &name
      validate
        check :nameFree [
          that=async ({ input, tx }) => (await tx.readMachine({ filter: { name: { eq: input.name } }, limit: 1 })).length === 0
          code="machine.name-free"
          message="a machine already has that name"
        ]
      do
        set
          &firstReportedBy=({ actor }) => actor.id
    update :update
      input
        &platform
        integer :expectedVersion nullable
      validate
        check :machineActive [
          that=() => &state === :active
          code="machine.active"
          message="the machine is retired"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
    update :retire
      input
        string :reason min=1
        integer :expectedVersion nullable
      validate
        check :machineActive [
          that=() => &state === :active
          code="machine.active"
          message="the machine is retired"
        ]
        check :machineIdle [
          that=() => !&attempts.some((a) => a.state === :running)
          code="machine.idle"
          message="an attempt on this machine is reported running"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &state=:retired
          &version=() => &version + 1
  policies
    policy :untilM8b
      authorize-if=() => true
