import { Task } from "../work/task.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { Attempt } from "./attempt.mesh.mx"
import { taskOpenOf } from "../work/work.helpers"
import { responsibleFor, runRunningOf } from "./execution.helpers"

entity :Run table="runs"
  attributes
    uuid :id primary-key
    json :inputs default={}
    json :outcome
    enum :state values=[:running, :succeeded, :failed, :canceled] default=:running
    string :cancelReason nullable
    timestamp :endedAt nullable
    integer :version default=1
    timestamp :startedAt on=:create
  relationships
    belongs-to :task entity=Task
    belongs-to :responsible entity=Collaborator
    belongs-to :startedBy entity=Collaborator
    belongs-to :parentRun entity=Run nullable
    has-many :attempts entity=Attempt
  actions auto=[:read]
    create :start
      input
        &task
        &inputs
        &parentRun
      validate
        check :taskOpen [
          that=({ input, tx }) => taskOpenOf(tx, input.task)
          code="run.task-open"
          message="runs serve open tasks"
        ]
        check :parentRunning [
          that=async ({ input, tx }) => input.parentRun == null || await runRunningOf(tx, input.parentRun)
          code="run.parent-running"
          message="the parent run is not running"
        ]
      do
        set
          &startedBy=({ actor }) => actor.id
          &responsible=({ actor }) => responsibleFor(&task.assignments, actor.id)
    update :cancel
      input
        string :reason min=1
        integer :expectedVersion nullable
      validate
        check :cancelable [
          that=() => &state === :running
          code="run.cancelable"
          message="the run is not running"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &state=:canceled
          &endedAt=() => now()
          &cancelReason=({ input }) => input.reason
          &version=() => &version + 1
    update :settle
      input
        enum :result values=[:succeeded, :failed]
        &outcome
      do
        set
          &state=({ input }) => input.result
          &endedAt=() => now()
          &version=() => &version + 1
  policies
    policy :untilM8b
      authorize-if=() => true
