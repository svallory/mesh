import { Collaborator } from "./collaborator.mesh.mx"

entity :Membership table="memberships"
  attributes
    uuid :id primary-key
    enum :role values=[:owner, :member, :guest]
    enum :state values=[:active, :revoked] default=:active
    timestamp :grantedAt
    timestamp :revokedAt nullable
    integer :version default=1
  relationships
    belongs-to :collaborator entity=Collaborator
    belongs-to :grantedBy entity=Collaborator
    belongs-to :revokedBy entity=Collaborator nullable
  actions auto=[:read]
    create :grant
      input
        &role
        &grantedAt
        &collaborator
        &grantedBy
    update :changeRole
      input
        &role
        integer :expectedVersion nullable
      validate
        check :membershipActive [
          that=() => &state === :active
          code="membership.active"
          message="the membership is revoked"
        ]
        check :roleChanges [
          that=({ before }) => &role !== before.role
          code="membership.unchanged"
          message="the member already has that role"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input, before }) => ({ expectedVersion: input.expectedVersion, actualVersion: before.version })
        ]
      do
        set
          &version=() => &version + 1
