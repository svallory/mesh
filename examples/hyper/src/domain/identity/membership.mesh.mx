import { Collaborator } from "./collaborator.mesh.mx"
import { collaboratorActiveOf, keepsAnOwnerOf, memberOf, noActiveMembershipOf, roleIn } from "./identity.helpers"

entity :Membership table="memberships"
  attributes
    uuid :id primary-key
    enum :role values=[:owner, :member, :guest]
    enum :state values=[:active, :revoked] default=:active
    timestamp :grantedAt
    timestamp :revokedAt nullable
    integer :version default=1
  relationships
    belongs-to :collaborator entity=Collaborator
    belongs-to :grantedBy entity=Collaborator
    belongs-to :revokedBy entity=Collaborator nullable
  actions auto=[:read]
    create :grant
      input
        &collaborator
        &role
      validate
        check :collaboratorActive [
          that=({ input, tx }) => collaboratorActiveOf(tx, input.collaborator)
          code="collaborator.active"
          message="the collaborator is retired"
        ]
        check :noneActive [
          that=({ input, tx }) => noActiveMembershipOf(tx, input.collaborator)
          code="membership.none-active"
          message="the collaborator already has an active membership; change its role instead"
        ]
      do
        set
          &grantedAt=() => now()
          &grantedBy=({ actor }) => actor.id
    update :changeRole
      input
        &role
        integer :expectedVersion nullable
      validate
        check :membershipActive [
          that=() => &state === :active
          code="membership.active"
          message="the membership is revoked"
        ]
        check :roleChanges [
          that=({ input }) => (input.role ?? &role) !== &role
          code="membership.unchanged"
          message="the member already has that role"
        ]
        check :lastOwner [
          that=({ input, tx }) => keepsAnOwnerOf(tx, &state === :active && &role === :owner && (input.role ?? &role) !== :owner)
          code="membership.last-owner"
          message="the workspace would have no owner; grant another owner first"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
    update :revoke
      input
        string :reason nullable
        integer :expectedVersion nullable
      validate
        check :membershipActive [
          that=() => &state === :active
          code="membership.active"
          message="the membership is revoked"
        ]
        check :lastOwner [
          that=({ tx }) => keepsAnOwnerOf(tx, &state === :active && &role === :owner)
          code="membership.last-owner"
          message="the workspace would have no owner; grant another owner first"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &state=:revoked
          &revokedAt=() => now()
          &revokedBy=({ actor }) => actor.id
          &version=() => &version + 1
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => isSystem(context) || actor.role != null
    policy :isMember actions=[&grant, &changeRole, &revoke]
      authorize-if=({ actor, context, tx }) => isSystem(context) || memberOf(tx, actor.id)
    policy :ownerOnly actions=[&grant, &changeRole, &revoke]
      authorize-if=({ actor, context, tx }) => isSystem(context) || roleIn(tx, actor.id, [:owner])
