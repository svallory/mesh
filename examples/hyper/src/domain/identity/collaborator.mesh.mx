import { Membership } from "./membership.mesh.mx"
import { nameFreeOf, retireKeepsAnOwnerOf } from "./identity.helpers"

entity :Collaborator table="collaborators"
  attributes
    uuid :id primary-key
    enum :kind values=[:human, :agent]
    string :name
    enum :state values=[:active, :retired] default=:active
    integer :version default=1
  relationships
    has-many :memberships entity=Membership
  actions auto=[:read]
    create :register
      input
        &kind
        &name
      validate
        check :nameUnique [
          that=({ input, tx }) => nameFreeOf(tx, input.name, null)
          code="collaborator.name-unique"
          message="another active collaborator has that name"
        ]
    update :update
      input
        &name
        enum :kind values=[:human, :agent] nullable
        integer :expectedVersion nullable
      validate
        check :collaboratorActive [
          that=() => &state === :active
          code="collaborator.active"
          message="the collaborator is retired"
        ]
        check :kindImmutable [
          that=({ input }) => input.kind == null || input.kind === &kind
          code="collaborator.kind-immutable"
          message="a collaborator keeps its kind"
        ]
        check :nameUnique [
          that=({ input, tx }) => nameFreeOf(tx, input.name ?? &name, &id)
          code="collaborator.name-unique"
          message="another active collaborator has that name"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
    update :retire
      input
        string :reason nullable
        integer :expectedVersion nullable
      validate
        check :collaboratorActive [
          that=() => &state === :active
          code="collaborator.active"
          message="the collaborator is retired"
        ]
        check :lastOwner [
          that=({ tx }) => retireKeepsAnOwnerOf(tx, &id)
          code="membership.last-owner"
          message="the workspace would have no owner; grant another owner first"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &state=:retired
          &version=() => &version + 1
  policies
    policy :untilM8b
      authorize-if=() => true
