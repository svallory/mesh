entity :Collaborator table="collaborators"
  attributes
    uuid :id primary-key
    enum :kind values=[:human, :agent]
    string :name
    enum :state values=[:active, :retired] default=:active
    timestamp :retiredAt nullable
    integer :version default=1
    timestamp :createdAt on=:create
  actions auto=[:read]
    create :register
      input
        &kind
        &name
    update :update
      input
        &name
