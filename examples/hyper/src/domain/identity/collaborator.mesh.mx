import { Membership } from "./membership.mesh.mx"
import { CollaboratorRegistered } from "./collaborator-registered.mesh.mx"
import { CollaboratorUpdated } from "./collaborator-updated.mesh.mx"
import { CollaboratorRetired } from "./collaborator-retired.mesh.mx"
import { memberOf, nameFreeOf, retireKeepsAnOwnerOf, roleIn } from "./identity.helpers"
import { changesOf } from "../changes"
import { Mesh } from "meshfw"

entity :Collaborator table="collaborators"
  attributes
    uuid :id primary-key
    enum :kind values=[:human, :agent]
    string :name
    enum :state values=[:active, :retired] default=:active
    integer :version default=1
  relationships
    has-many :memberships entity=Membership
  checks
    check :collaboratorActive [
      that=() => &state === :active
      code="collaborator.active"
      message="the collaborator is retired"
    ]
  actions auto=[:read]
    create :register
      input
        &kind
        &name
      validate
        check :nameUnique [
          that=async ({ input }) => await nameFreeOf(input.name, null)
          code="collaborator.name-unique"
          message="another active collaborator has that name"
        ]
      do
        publish=() => new CollaboratorRegistered({ kind: &kind, name: &name })
    update :update
      input
        &name
        enum :kind values=[:human, :agent] nullable
      validate
        check &collaboratorActive
        check :kindImmutable [
          that=({ input }) => input.kind == null || input.kind === &kind
          code="collaborator.kind-immutable"
          message="a collaborator keeps its kind"
        ]
        check :nameStaysUnique [
          that=async ({ input }) => await nameFreeOf(input.name ?? &name, &id)
          code="collaborator.name-unique"
          message="another active collaborator has that name"
        ]
      do
        lock &version optional
        publish=({ before, self }) => new CollaboratorUpdated({ changes: changesOf(before, self, ["name", "kind"]) })
    update :retire
      input
        string :reason nullable
      validate
        check &collaboratorActive
        check :lastOwner [
          that=async ({}) => await retireKeepsAnOwnerOf(&id)
          code="membership.last-owner"
          message="the workspace would have no owner; grant another owner first"
        ]
      do
        lock &version optional
        set
          &state=:retired
        publish=({ input }) => new CollaboratorRetired({ reason: input.reason ?? null })
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&register, &update, &retire]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOnly actions=[&register, &retire]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner])
    policy :collaboratorSelfOrOwner actions=[&update]
      authorize-if=async ({ self, actor, context }) => Mesh.isSystem(context) || self.id === actor.id || await roleIn(actor.id, [:owner])
