import { WorkspaceCreated } from "./workspace-created.mesh.mx"
import { WorkspaceRenamed } from "./workspace-renamed.mesh.mx"
import { memberOf, noWorkspaceOf, roleIn } from "./identity.helpers"
import { Mesh } from "meshfw"

entity :Workspace table="workspaces"
  attributes
    uuid :id primary-key
    string :name nullable
    enum :location values=[:local, :shared] default=:local
    enum :state values=[:active, :moved] default=:active
    integer :version default=1
  actions auto=[:read]
    create :create
      input
        &name
        &location
        uuid :firstOwner nullable
      validate
        check :workspaceUnique [
          that=async () => await noWorkspaceOf()
          code="workspace.exists"
          message="this engine already hosts its workspace; read it with workspace.get, or rename it"
        ]
      do
        publish=({ input, actor }) => new WorkspaceCreated({ name: &name, location: &location, firstOwnerId: input.firstOwner ?? actor.id })
    update :rename
      input
        &name
        integer :expectedVersion nullable
      validate
        check :workspaceActive [
          that=() => &state === :active
          code="workspace.active"
          message="the workspace has moved; it can no longer be changed"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
        publish=({ before }) => new WorkspaceRenamed({ oldName: before.name, newName: &name ?? "" })
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&create, &rename]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOnly actions=[&create, &rename]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner])
