import { Submission } from "./submission.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { Task } from "./task.mesh.mx"
import { ReviewAccepted } from "./review-accepted.mesh.mx"
import { ReviewReturned } from "./review-returned.mesh.mx"
import { reviewerRuleOf, reviewsSubmissionOf, submittedVersionsOf } from "./work.helpers"
import { memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :Review table="reviews"
  attributes
    uuid :id primary-key
    enum :decision values=[:accept, :return]
    string :reasons nullable
    enum :ruleApplied values=[:parent-assignee, :parent-creator, :task-creator]
    timestamp :decidedAt on=:create
  relationships
    belongs-to :submission entity=Submission
    belongs-to :reviewer entity=Collaborator
  actions auto=[:read]
    create :accept
      input
        &submission
        integer :expectedVersion nullable
      validate
        check :pending [
          that=async ({ input }) => (await submittedVersionsOf(input.submission)).state === :pending
          code="submission.pending"
          message="the submission is not pending"
        ]
        check :versionMatches [
          that=async ({ input }) => input.expectedVersion == null || input.expectedVersion === (await submittedVersionsOf(input.submission)).current
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=async ({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: (await submittedVersionsOf(input.submission)).current })
        ]
      do
        set
          &decision=:accept
          &reviewer=({ actor }) => actor.id
          &ruleApplied=async ({}) => await reviewerRuleOf(&submission.taskId)
        run [after=:write] ({ self, context }) {
          const submission = await Submission.settle({ id: self.submissionId, outcome: :accepted }, { ...context, system: true });
          await Task.touch({ id: submission.taskId }, { ...context, system: true });
        }
        publish=({ self }) => new ReviewAccepted({ reviewId: &id, submissionId: self.submissionId, reviewerId: self.reviewerId, ruleApplied: &ruleApplied })
        run [after=:write] ({ self, context }) {
          const [submission] = await Mesh.privileged(Submission).read({ filter: { id: { eq: self.submissionId } }, limit: 1 });
          if (submission === undefined) throw new Error(`submission ${self.submissionId} not found`);
          await Task.complete({ id: submission.taskId }, { ...context, system: true, completion: { rule: "review-accepted", submissionId: submission.id } });
        }
    create :return
      input
        string :reasons min=1
        &submission
        integer :expectedVersion nullable
      validate
        check :pending [
          that=async ({ input }) => (await submittedVersionsOf(input.submission)).state === :pending
          code="submission.pending"
          message="the submission is not pending"
        ]
        check :versionMatches [
          that=async ({ input }) => input.expectedVersion == null || input.expectedVersion === (await submittedVersionsOf(input.submission)).current
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=async ({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: (await submittedVersionsOf(input.submission)).current })
        ]
      do
        set
          &decision=:return
          &reasons=({ input }) => input.reasons
          &reviewer=({ actor }) => actor.id
          &ruleApplied=async ({}) => await reviewerRuleOf(&submission.taskId)
        run [after=:write] ({ self, context }) {
          const submission = await Submission.settle({ id: self.submissionId, outcome: :returned }, { ...context, system: true });
          await Task.touch({ id: submission.taskId }, { ...context, system: true });
        }
        publish=({ self }) => new ReviewReturned({ reviewId: &id, submissionId: self.submissionId, reviewerId: self.reviewerId, reasons: &reasons ?? "" })
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&accept, &return]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&accept, &return]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
    policy :reviewReviewer actions=[&accept, &return]
      authorize-if=async ({ input, actor, context }) => Mesh.isSystem(context) || await reviewsSubmissionOf(input.submission, actor.id)
