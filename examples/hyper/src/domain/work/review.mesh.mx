import { Submission } from "./submission.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { reviewerRuleOf, submittedVersionsOf, taskUnchangedSinceSubmit } from "./work.helpers"

entity :Review table="reviews"
  attributes
    uuid :id primary-key
    enum :decision values=[:accept, :return]
    string :reasons nullable
    enum :ruleApplied values=[:parent-assignee, :parent-creator, :task-creator]
    timestamp :decidedAt on=:create
  relationships
    belongs-to :submission entity=Submission
    belongs-to :reviewer entity=Collaborator
  actions auto=[:read]
    create :accept
      input
        &submission
        integer :expectedVersion nullable
      validate
        check :pending [
          that=async ({ input, tx }) => (await submittedVersionsOf(tx, input.submission)).state === :pending
          code="submission.pending"
          message="the submission is not pending"
        ]
        check :taskVersion [
          that=async ({ input, tx }) => taskUnchangedSinceSubmit(await submittedVersionsOf(tx, input.submission))
          code="submission.task-version"
          message="the task changed since this was submitted; return it for rework"
          details=async ({ input, tx }) => { const { submitted, current } = await submittedVersionsOf(tx, input.submission); return { submitted, current }; }
        ]
        check :versionMatches [
          that=async ({ input, tx }) => input.expectedVersion == null || input.expectedVersion === (await submittedVersionsOf(tx, input.submission)).current
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=async ({ input, tx }) => ({ expectedVersion: input.expectedVersion, actualVersion: (await submittedVersionsOf(tx, input.submission)).current })
        ]
      do
        set
          &decision=:accept
          &reviewer=({ actor }) => actor.id
          &ruleApplied=({ tx }) => reviewerRuleOf(tx, &submission.taskId)
        run [after=:write] ({ self, context, actions }) {
          const submission = await actions.settleSubmission({ id: self.submissionId, outcome: :accepted });
          await actions.completeTask({ id: submission.taskId }, { ...context, completion: { rule: "review-accepted", submissionId: submission.id } });
        }
    create :return
      input
        string :reasons min=1
        &submission
        integer :expectedVersion nullable
      validate
        check :pending [
          that=async ({ input, tx }) => (await submittedVersionsOf(tx, input.submission)).state === :pending
          code="submission.pending"
          message="the submission is not pending"
        ]
        check :versionMatches [
          that=async ({ input, tx }) => input.expectedVersion == null || input.expectedVersion === (await submittedVersionsOf(tx, input.submission)).current
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=async ({ input, tx }) => ({ expectedVersion: input.expectedVersion, actualVersion: (await submittedVersionsOf(tx, input.submission)).current })
        ]
      do
        set
          &decision=:return
          &reasons=({ input }) => input.reasons
          &reviewer=({ actor }) => actor.id
          &ruleApplied=({ tx }) => reviewerRuleOf(tx, &submission.taskId)
        run [after=:write] ({ self, actions }) {
          const submission = await actions.settleSubmission({ id: self.submissionId, outcome: :returned });
          await actions.touchTask({ id: submission.taskId });
        }
