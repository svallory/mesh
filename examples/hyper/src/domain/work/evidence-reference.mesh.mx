import { Collaborator } from "../identity/collaborator.mesh.mx"
import { memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :EvidenceReference table="evidence_references"
  attributes
    uuid :id primary-key
    string :kind
    string :locator
    string :contentHash nullable
    string :description nullable
    timestamp :recordedAt on=:create
  relationships
    belongs-to :recordedBy entity=Collaborator
  actions auto=[:read]
    create :record
      input
        &kind
        &locator
        &contentHash
        &description
      do
        set
          &recordedBy=({ actor }) => actor.id
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&record]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&record]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
