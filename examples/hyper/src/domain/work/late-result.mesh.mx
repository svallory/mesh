import { Task } from "./task.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { ClaimLateResultRecorded } from "./claim-late-result-recorded.mesh.mx"
import { claimsOf, isStale, missingEvidenceOf } from "./work.helpers"
import { memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :LateResult table="late_results"
  attributes
    uuid :id primary-key
    integer :fence min=1
    string :summary nullable
    json :evidence default=[]
    timestamp :recordedAt on=:create
  relationships
    belongs-to :task entity=Task
    belongs-to :submitter entity=Collaborator
  actions auto=[:read]
    create :record
      input
        &task
        &fence
        &summary
        &evidence
      validate
        check :staleFence [
          that=async ({ input, actor }) => isStale(await claimsOf(input.task), input.fence, actor.id, %.now)
          code="claim.stale-fence"
          message="only a fence you held that expired or was revoked records a late result"
        ]
        check :evidenceExists [
          that=async ({ input }) => (await missingEvidenceOf(input.evidence ?? &evidence)).length === 0
          code="evidence.exists"
          message="an evidence reference does not exist"
          details=async ({ input }) => ({ missing: await missingEvidenceOf(input.evidence ?? &evidence) })
        ]
      do
        set
          &submitter=({ actor }) => actor.id
        publish=({ self }) => new ClaimLateResultRecorded({ lateResultId: &id, fence: &fence, submitterId: self.submitterId, summary: &summary, evidence: &evidence })
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&record]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&record]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
