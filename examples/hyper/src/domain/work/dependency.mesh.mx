import { Task } from "./task.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { dependencyExistsOf, missingTasksOf, prerequisiteReachesOf, taskVersionOf } from "./work.helpers"
import { memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :Dependency table="dependencies"
  attributes
    uuid :id primary-key
    timestamp :createdAt on=:create
  relationships
    belongs-to :dependent entity=Task
    belongs-to :prerequisite entity=Task
    belongs-to :createdBy entity=Collaborator
  actions auto=[:read]
    create :add
      input
        &dependent
        &prerequisite
        integer :expectedVersion nullable
      validate
        check :exists [
          that=async ({ input }) => (await missingTasksOf([input.dependent, input.prerequisite])).length === 0
          code="dependency.exists"
          message="a task of the dependency does not exist"
          details=async ({ input }) => ({ missing: await missingTasksOf([input.dependent, input.prerequisite]) })
        ]
        check :distinct [
          that=({ input }) => input.dependent !== input.prerequisite
          code="dependency.distinct"
          message="a task cannot depend on itself"
        ]
        check :duplicate [
          that=async ({ input }) => !(await dependencyExistsOf(input.dependent, input.prerequisite))
          code="dependency.duplicate"
          message="the dependency already exists"
        ]
        check :noCycle [
          that=async ({ input }) => !(await prerequisiteReachesOf(input.prerequisite, input.dependent))
          code="dependency.no-cycle"
          message="the prerequisite already waits for the dependent"
        ]
        check :versionMatches [
          that=async ({ input }) => input.expectedVersion == null || [input.expectedVersion, null].includes(await taskVersionOf(input.dependent))
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=async ({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: await taskVersionOf(input.dependent) })
        ]
      do
        set
          &createdBy=({ actor }) => actor.id
        run [after=:write] ({ self, context }) {
          await Task.touch({ id: self.dependentId }, { ...context, system: true });
        }
    destroy :remove
      input
        string :reason nullable
        integer :expectedVersion nullable
      validate
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &dependent.version
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &dependent.version })
        ]
      do
        run [after=:write] ({ self, context }) {
          await Task.touch({ id: self.dependentId }, { ...context, system: true });
        }
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&add, &remove]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&add, &remove]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
