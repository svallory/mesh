import { Task } from "./task.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { Mesh } from "meshfw"

entity :Assignment table="assignments"
  attributes
    uuid :id primary-key
    boolean :reviewWaived default=false
    timestamp :startedAt
    timestamp :endedAt nullable
    enum :endReason values=[:reassigned, :unassigned] nullable
  relationships
    belongs-to :task entity=Task
    belongs-to :assignee entity=Collaborator
    belongs-to :delegator entity=Collaborator
  actions auto=[:read]
    create :start
      input
        &task
        &assignee
        &reviewWaived
      do
        set
          &delegator=({ actor }) => actor.id
          &startedAt=() => Mesh.now()
    update :finish
      input
        enum :reason values=[:reassigned, :unassigned]
      validate
        check :current [
          that=() => &endedAt === null
          code="assignment.current"
          message="the assignment has already ended"
        ]
      do
        set
          &endedAt=() => Mesh.now()
          &endReason=({ input }) => input.reason
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :internal actions=[&start, &finish]
      authorize-if=({ context }) => Mesh.isSystem(context)
