import { Dependency } from "./dependency.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { Assignment } from "./assignment.mesh.mx"
import { Claim } from "./claim.mesh.mx"
import { Submission } from "./submission.mesh.mx"
import { Completion } from "./completion.mesh.mx"
import { TaskCreated } from "./task-created.mesh.mx"
import { TaskUpdated } from "./task-updated.mesh.mx"
import { TaskPrioritySet } from "./task-priority-set.mesh.mx"
import { TaskMoved } from "./task-moved.mesh.mx"
import { TaskCanceled } from "./task-canceled.mesh.mx"
import { TaskReopened } from "./task-reopened.mesh.mx"
import { changesOf } from "../changes"
import { acceptedSubmissionOf, assignmentChanges, childrenSettledReason, claimNotInvalidated, claimToRelease, completionRule, currentAssignment, fenceDetails, fenceIsCurrent, invalidatedFences, liveClaims, managesTaskOf, missingEvidenceOf, movedParent, noContainmentCycleOf, noOtherHolderOf, openChildren, ownPending, parentOpenOf, reviewerFor, reviewNotRequiredOf, taskChanges } from "./work.helpers"
import { assignableOf, collaboratorActiveOf, memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :Task table="tasks"
  attributes
    uuid :id primary-key
    string :title
    string :intent nullable
    integer :priority nullable
    enum :state values=[:open, :done, :canceled] default=:open
    integer :version default=1
    timestamp :createdAt on=:create
    timestamp :reopenedAt nullable
  relationships
    belongs-to :parent entity=Task nullable
    belongs-to :creator entity=Collaborator
    has-many :children entity=Task
    has-many :dependencies entity=Dependency inverse=:dependent
    has-many :dependents entity=Dependency inverse=:prerequisite
    has-many :assignments entity=Assignment
    has-many :claims entity=Claim
    has-many :submissions entity=Submission
    has-many :completions entity=Completion
  computed
    boolean :childrenSettled() { return &children.every((c) => c.state !== :open) }
    boolean :claimed() { return &claims.some((c) => c.state === :active && c.expiresAt > %.now) }
    boolean :lapsedClaim() { return &claims.some((c) => c.state === :active && c.expiresAt <= %.now) }
    boolean :inReview() { return &submissions.some((s) => s.state === :pending) }
    boolean :assigned() { return &assignments.some((a) => a.endedAt === null) }
    boolean :blocked() { return &dependencies.some((d) => d.prerequisite.state !== :done) }
    max :maxFence of=&claims.fence
    enum :derivedState values=[:ready, :blocked, :claimed, :in-review, :done, :canceled] value=() => &state === :done ? :done : &state === :canceled ? :canceled : &inReview ? :in-review : &claimed ? :claimed : &blocked ? :blocked : :ready
  actions auto=[:read]
    create :create
      input
        &title
        &intent
        &parent
        &priority
      validate
        check :parentOpen [
          that=async ({ input }) => await parentOpenOf(input.parent ?? null)
          code="task.parent-open"
          message="the parent task is not open"
        ]
      do
        set
          &creator=({ actor }) => actor.id
        publish=({ self }) => new TaskCreated({ title: &title, intent: &intent, parentId: self.parentId, priority: &priority, creatorId: self.creatorId })
    update :update
      input
        &title
        &intent
        integer :expectedVersion nullable
      validate
        check :taskOpen [
          that=() => &state === :open
          code="task.open"
          message="the task is not open; reopen it first"
        ]
        check :taskChanges [
          that=({ self, input }) => taskChanges(self, input)
          code="task.unchanged"
          message="nothing to change: every field already has that value"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
        publish=({ before, self }) => new TaskUpdated({ changes: changesOf(before, self, ["title", "intent"]) })
    update :setPriority
      input
        &priority
        integer :expectedVersion nullable
      validate
        check :taskOpen [
          that=() => &state === :open
          code="task.open"
          message="the task is not open; reopen it first"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
        publish=({ before }) => new TaskPrioritySet({ oldPriority: before.priority, newPriority: &priority })
    update :move
      input
        &parent
        integer :expectedVersion nullable
      validate
        check :taskOpen [
          that=() => &state === :open
          code="task.open"
          message="the task is not open; reopen it first"
        ]
        check :parentOpen [
          that=async ({ self, input }) => await parentOpenOf(movedParent(self, input.parent))
          code="task.parent-open"
          message="the parent task is not open"
        ]
        check :noCycle [
          that=async ({ input }) => await noContainmentCycleOf(&id, input.parent)
          code="task.no-cycle"
          message="the new parent is this task or one of its descendants"
        ]
        check :noActiveClaim [
          that=() => !&claimed
          code="task.no-active-claim"
          message="release or revoke the active claim first"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
        publish=({ self, before }) => new TaskMoved({ oldParentId: before.parentId, newParentId: self.parentId })
    update :reopen
      input
        string :reason
        integer :expectedVersion nullable
      validate
        check :taskSettled [
          that=() => &state !== :open
          code="task.settled"
          message="the task is already open"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &state=:open
          &reopenedAt=() => %.now
          &version=() => &version + 1
        publish=({ before, input }) => new TaskReopened({ reason: input.reason, fromState: before.state === :canceled ? :canceled : :done })
    update :touch
      do
        set
          &version=() => &version + 1
    update :cancel
      input
        string :reason min=1
        integer :expectedVersion nullable
      validate
        check :taskOpen [
          that=() => &state === :open
          code="task.open"
          message="the task is not open; reopen it first"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &state=:canceled
          &version=() => &version + 1
        run [after=:write] ({ self, context }) {
          for (const claim of liveClaims(await Mesh.privileged(Claim).read({ filter: { taskId: { eq: self.id } } }), %.now))
            await Claim.end({ id: claim.id, outcome: :revoked, reason: "task canceled" }, { ...context, system: true });
          for (const submission of await Mesh.privileged(Submission).read({ filter: { taskId: { eq: self.id }, state: { eq: :pending } } }))
            await Submission.settle({ id: submission.id, outcome: :withdrawn }, { ...context, system: true });
        }
        publish=({ input }) => new TaskCanceled({ reason: input.reason })
    update :complete
      input
        integer :fence min=1 nullable
        string :summary min=1 nullable
        json :evidence
        integer :expectedVersion nullable
      validate
        check :taskOpen [
          that=() => &state === :open
          code="task.open"
          message="the task is not open; reopen it first"
        ]
        check :childrenSettled [
          that=() => &childrenSettled
          code="task.children-settled"
          message=() => childrenSettledReason(&children)
          details=() => ({ openChildren: openChildren(&children) })
        ]
        check :reviewRequired [
          that=async ({ self, actor }) => await reviewNotRequiredOf(self, actor.id)
          code="task.review-required"
          message="a review is required: submit the work for the reviewer to review"
          details=async ({ self }) => ({ reviewerId: (await reviewerFor(self)).collaboratorId })
        ]
        check :noForeignSubmission [
          that=({ actor }) => !&submissions.some((s) => s.state === :pending && s.submitterId !== actor.id)
          code="task.no-foreign-submission"
          message="another collaborator's submission is pending review"
        ]
        check :currentFence [
          that=({ input, actor }) => fenceIsCurrent(&claims, input.fence, actor.id, %.now)
          code="claim.current-fence"
          message="the fence is not your current claim; claim the task again"
          details=({ input, actor }) => fenceDetails(&maxFence, &claims, input.fence, actor.id, %.now)
        ]
        check :claimNotInvalidated [
          that=({ input, actor, context }) => claimNotInvalidated(&claims, input.fence, actor.id, &completions, &reopenedAt, %.now, context.completion)
          code="claim.invalidated"
          message="your claim on this task was invalidated; claim it again and complete with the new fence"
          details=({ actor }) => ({ fences: invalidatedFences(&claims, actor.id, &completions, &reopenedAt, %.now) })
        ]
        check :ownSubmissionPending [
          that=({ input, actor }) => (input.summary == null && input.evidence == null) || !&submissions.some((s) => s.state === :pending && s.submitterId === actor.id)
          code="submission.pending"
          message="your submission is pending review; withdraw it first"
        ]
        check :evidenceExists [
          that=async ({ input }) => (await missingEvidenceOf(input.evidence ?? [])).length === 0
          code="evidence.exists"
          message="an evidence reference does not exist"
          details=async ({ input }) => ({ missing: await missingEvidenceOf(input.evidence ?? []) })
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &state=:done
          // Review :accept touched the Task before it called this complete (context.completion), so the command bumps
          // the version once and review.accepted and task.completed carry the same one.
          &version=({ context }) => context.completion != null ? &version : &version + 1
        run [after=:write] ({ self, before, input, actor, context }) {
          let submission: string | null = null;
          let rule: "review-accepted" | "performer-is-reviewer" | "review-waived" = "review-accepted";
          if (context.completion) submission = await acceptedSubmissionOf(self.id, context.completion.submissionId);
          else {
            rule = completionRule(actor.id, await reviewerFor(self));
            if (input.summary != null || input.evidence != null) {
              const recorded = await Submission.recordAccepted({ task: self.id, summary: input.summary ?? null, evidence: input.evidence ?? [], fence: input.fence ?? null, taskVersion: before.version }, { ...context, system: true });
              submission = recorded.id;
            } else {
              const own = ownPending(await Mesh.privileged(Submission).read({ filter: { taskId: { eq: self.id }, state: { eq: :pending } } }), actor.id);
              if (own) {
                await Submission.settle({ id: own.id, outcome: :accepted }, { ...context, system: true });
                submission = own.id;
              }
            }
          }
          await Completion.record({ task: self.id, submission, rule }, { ...context, system: true });
          const live = claimToRelease(await Mesh.privileged(Claim).read({ filter: { taskId: { eq: self.id } } }), %.now);
          if (live) await Claim.end({ id: live.id, outcome: :released, reason: "completed" }, { ...context, system: true });
        }
    update :assign
      input
        uuid :assignee
        boolean :waiveReview nullable
        integer :expectedVersion nullable
      validate
        check :taskOpen [
          that=() => &state === :open
          code="task.open"
          message="the task is not open; reopen it first"
        ]
        check :assigneeActive [
          that=async ({ input }) => await collaboratorActiveOf(input.assignee)
          code="collaborator.active"
          message="the collaborator is retired"
        ]
        check :assigneeRole [
          that=async ({ input }) => await assignableOf(input.assignee)
          code="assignment.assignee-role"
          message="only members and owners can be assigned"
        ]
        check :assignmentChanges [
          that=({ input }) => assignmentChanges(&assignments, input.assignee, input.waiveReview ?? false)
          code="assignment.unchanged"
          message="assignee and review waiver are unchanged"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
        run [after=:write] ({ self, input, context }) {
          const current = currentAssignment(await Mesh.privileged(Assignment).read({ filter: { taskId: { eq: self.id }, endedAt: { nil: true } } }));
          if (current) {
            if (current.assigneeId !== input.assignee)
              for (const claim of liveClaims(await Mesh.privileged(Claim).read({ filter: { taskId: { eq: self.id } } }), %.now, current.assigneeId))
                await Claim.end({ id: claim.id, outcome: :revoked, reason: "reassigned" }, { ...context, system: true });
            await Assignment.finish({ id: current.id, reason: :reassigned }, { ...context, system: true });
          }
          await Assignment.start({ task: self.id, assignee: input.assignee, reviewWaived: input.waiveReview ?? false }, { ...context, system: true });
        }
    update :unassign
      input
        string :reason nullable
        integer :expectedVersion nullable
      validate
        check :assignmentCurrent [
          that=() => &assigned
          code="assignment.current"
          message="the task has no current assignment"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &version
          code="expected-version"
          message="the record is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &version })
        ]
      do
        set
          &version=() => &version + 1
        run [after=:write] ({ self, context }) {
          const current = currentAssignment(await Mesh.privileged(Assignment).read({ filter: { taskId: { eq: self.id }, endedAt: { nil: true } } }));
          if (!current) return;
          for (const claim of liveClaims(await Mesh.privileged(Claim).read({ filter: { taskId: { eq: self.id } } }), %.now, current.assigneeId))
            await Claim.end({ id: claim.id, outcome: :revoked, reason: "unassigned" }, { ...context, system: true });
          await Assignment.finish({ id: current.id, reason: :unassigned }, { ...context, system: true });
        }
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&create, &update, &setPriority, &move, &assign, &complete, &cancel, &reopen, &unassign]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&create, &update, &setPriority, &move, &assign, &complete, &cancel, &reopen, &unassign]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
    policy :taskManager actions=[&cancel, &reopen]
      authorize-if=async ({ self, actor, context }) => Mesh.isSystem(context) || await managesTaskOf(self, actor.id, true)
    policy :taskUnassigner actions=[&unassign]
      authorize-if=async ({ self, actor, context }) => Mesh.isSystem(context) || await managesTaskOf(self, actor.id, false)
    policy :claimHolder actions=[&complete]
      authorize-if=async ({ self, input, actor, context }) => Mesh.isSystem(context) || await noOtherHolderOf(self.id, input.fence, actor.id, %.now)
    policy :reviewCompletion actions=[&complete]
      forbid-if=({ context }) => context.completion != null && !Mesh.isSystem(context)
    policy :internal actions=[&touch]
      authorize-if=({ context }) => Mesh.isSystem(context)
