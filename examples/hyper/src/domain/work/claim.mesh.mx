import { Task } from "./task.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"

entity :Claim table="claims"
  attributes
    uuid :id primary-key
    integer :fence
    timestamp :acquiredAt
    timestamp :expiresAt
    timestamp :endedAt nullable
    string :endReason nullable
    enum :state values=[:active, :released, :revoked, :expired] default=:active
  relationships
    belongs-to :task entity=Task
    belongs-to :holder entity=Collaborator
  computed
    boolean :lapsed() { return &state === :active && &expiresAt <= now() }
  actions auto=[:read]
    create :acquire
      input
        &fence
        &acquiredAt
        &expiresAt
        &task
        &holder
