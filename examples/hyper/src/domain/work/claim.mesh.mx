import { Task } from "./task.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { Assignment } from "./assignment.mesh.mx"
import { ClaimAcquired } from "./claim-acquired.mesh.mx"
import { ClaimRenewed } from "./claim-renewed.mesh.mx"
import { ClaimReleased } from "./claim-released.mesh.mx"
import { ClaimRevoked } from "./claim-revoked.mesh.mx"
import { ClaimExpired } from "./claim-expired.mesh.mx"
import { assigneeMayClaimOf, derivedStateOf, leaseEnd, readinessOf, revokesClaimOf, taskVersionOf } from "./work.helpers"
import { memberOf, roleIn } from "../identity/identity.helpers"
import { Mesh } from "meshfw"

entity :Claim table="claims"
  attributes
    uuid :id primary-key
    integer :fence
    timestamp :acquiredAt
    timestamp :expiresAt
    timestamp :endedAt nullable
    string :endReason nullable
    enum :state values=[:active, :released, :revoked, :expired] default=:active
  relationships
    belongs-to :task entity=Task
    belongs-to :holder entity=Collaborator
  computed
    boolean :lapsed() { return &state === :active && &expiresAt <= %.now }
  actions auto=[:read]
    create :acquire
      input
        &task
        integer :expectedVersion nullable
      validate
        check :taskReady [
          that=async ({ input }) => (await derivedStateOf(input.task)) === :ready
          code="claim.task-ready"
          message="the task is not ready to claim"
          details=async ({ input }) => await readinessOf(input.task)
        ]
        check :versionMatches [
          that=async ({ input }) => input.expectedVersion == null || input.expectedVersion === await taskVersionOf(input.task)
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=async ({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: await taskVersionOf(input.task) })
        ]
      do
        set
          &holder=({ actor }) => actor.id
          &fence=() => (&task.maxFence ?? 0) + 1
          &acquiredAt=() => %.now
          &expiresAt=({ context }) => leaseEnd(%.now, context.leaseMs)
        run [after=:write] ({ self, context }) {
          await Task.touch({ id: self.taskId }, { ...context, system: true });
        }
        publish=({ self }) => new ClaimAcquired({ claimId: &id, taskId: self.taskId, holderId: self.holderId, fence: &fence, expiresAt: structuredClone(&expiresAt) })
        // The lapsed claims end after claim.acquired is published, so the command's first event is its own and its
        // cause is the command (PROTOCOL.md §4.2); each claim.expired that follows names the lease-expiry rule.
        run [after=:write] ({ self, context }) {
          const lapsed = await Mesh.privileged(Claim).read({ filter: { taskId: { eq: self.taskId }, state: { eq: :active }, expiresAt: { lte: %.now } } });
          for (const claim of lapsed) await Claim.end({ id: claim.id, outcome: :expired, reason: "lease expired" }, { ...context, system: true });
          const open = await Mesh.privileged(Assignment).read({ filter: { taskId: { eq: self.taskId }, endedAt: { nil: true } }, limit: 1 });
          if (open.length === 0) await Assignment.start({ task: self.taskId, assignee: self.holderId, reviewWaived: false }, { ...context, system: true });
        }
    update :renew
      input
        integer :fence
        integer :expectedVersion nullable
      validate
        check :currentFence [
          that=({ input }) => input.fence === &fence && input.fence === &task.maxFence
          code="claim.current-fence"
          message="the fence is not the current claim's; claim the task again"
          details=() => ({ currentFence: &task.maxFence, stale: false })
        ]
        check :claimActive [
          that=() => &state !== :released && &state !== :revoked
          code="claim.active"
          message="the claim was released or revoked; claim the task again"
        ]
        check :claimNotExpired [
          that=() => &state !== :expired && &expiresAt > %.now
          code="claim.expired"
          message="the lease has expired; claim the task again"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &task.version
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &task.version })
        ]
      do
        set
          &expiresAt=({ context }) => leaseEnd(%.now, context.leaseMs)
        run [after=:write] ({ self, context }) {
          await Task.touch({ id: self.taskId }, { ...context, system: true });
        }
        publish=() => new ClaimRenewed({ claimId: &id, fence: &fence, expiresAt: structuredClone(&expiresAt) })
    update :release
      input
        integer :fence
        string :reason nullable
        integer :expectedVersion nullable
      validate
        check :currentFence [
          that=({ input }) => input.fence === &fence && input.fence === &task.maxFence
          code="claim.current-fence"
          message="the fence is not the current claim's; claim the task again"
          details=() => ({ currentFence: &task.maxFence, stale: false })
        ]
        check :claimActive [
          that=() => &state !== :released && &state !== :revoked
          code="claim.active"
          message="the claim was released or revoked; claim the task again"
        ]
        check :claimNotExpired [
          that=() => &state !== :expired && &expiresAt > %.now
          code="claim.expired"
          message="the lease has expired; claim the task again"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &task.version
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &task.version })
        ]
      do
        set
          &state=:released
          &endedAt=() => %.now
          &endReason=({ input }) => input.reason ?? "released"
        run [after=:write] ({ self, context }) {
          await Task.touch({ id: self.taskId }, { ...context, system: true });
        }
        publish=() => new ClaimReleased({ claimId: &id, fence: &fence, endReason: &endReason ?? "released" })
    update :revoke
      input
        string :reason min=1
        integer :expectedVersion nullable
      validate
        check :claimActive [
          that=() => &state === :active && !&lapsed
          code="claim.active"
          message="the claim has ended or its lease has run out; there is no active claim to revoke"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &task.version
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &task.version })
        ]
      do
        set
          &state=:revoked
          &endedAt=() => %.now
          &endReason=({ input }) => input.reason
        run [after=:write] ({ self, context }) {
          await Task.touch({ id: self.taskId }, { ...context, system: true });
        }
        publish=({ input, actor }) => new ClaimRevoked({ claimId: &id, fence: &fence, revokedBy: actor.id, reason: input.reason })
    update :expire
      input
        string :reason nullable
      validate
        check :claimActive [
          that=() => &state === :active
          code="claim.active"
          message="the claim has ended; claim the task again"
        ]
      do
        set
          &state=:expired
          &endedAt=() => %.now
          &endReason=({ input }) => input.reason ?? "lease expired"
        run [after=:write] ({ self, context }) {
          await Task.touch({ id: self.taskId }, { ...context, system: true });
        }
        publish=() => new ClaimExpired({ claimId: &id, fence: &fence, expiredAt: structuredClone(&expiresAt) })
    update :end
      input
        enum :outcome values=[:released, :revoked, :expired]
        string :reason
      validate
        check :claimActive [
          that=() => &state === :active
          code="claim.active"
          message="the claim has ended; claim the task again"
        ]
      do
        set
          &state=({ input }) => input.outcome
          &endedAt=() => %.now
          &endReason=({ input }) => input.reason
        when=({ input }) => input.outcome === :released
          publish=({ input }) => new ClaimReleased({ claimId: &id, fence: &fence, endReason: input.reason })
        when=({ input }) => input.outcome === :revoked
          publish=({ input, actor }) => new ClaimRevoked({ claimId: &id, fence: &fence, revokedBy: actor.id, reason: input.reason })
        when=({ input }) => input.outcome === :expired
          publish=() => new ClaimExpired({ claimId: &id, fence: &fence, expiredAt: structuredClone(&expiresAt) })
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => Mesh.isSystem(context) || actor.role != null
    policy :isMember actions=[&acquire, &renew, &release, &revoke]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await memberOf(actor.id)
    policy :ownerOrMember actions=[&acquire, &renew, &release, &revoke]
      authorize-if=async ({ actor, context }) => Mesh.isSystem(context) || await roleIn(actor.id, [:owner, :member])
    policy :claimAssignee actions=[&acquire]
      authorize-if=async ({ input, actor, context }) => Mesh.isSystem(context) || await assigneeMayClaimOf(input.task, actor.id)
    policy :claimHolder actions=[&renew, &release]
      authorize-if=({ self, actor, context }) => Mesh.isSystem(context) || self.holderId === actor.id
    policy :claimRevoker actions=[&revoke]
      authorize-if=async ({ self, actor, context }) => Mesh.isSystem(context) || await revokesClaimOf(self.taskId, actor.id)
    policy :internal actions=[&expire, &end]
      authorize-if=({ context }) => Mesh.isSystem(context)
