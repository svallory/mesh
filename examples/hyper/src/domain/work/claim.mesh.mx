import { Task } from "./task.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { assigneeMayClaimOf, derivedStateOf, leaseEnd, readinessOf, revokesClaimOf, taskVersionOf } from "./work.helpers"
import { memberOf, roleIn } from "../identity/identity.helpers"

entity :Claim table="claims"
  attributes
    uuid :id primary-key
    integer :fence
    timestamp :acquiredAt
    timestamp :expiresAt
    timestamp :endedAt nullable
    string :endReason nullable
    enum :state values=[:active, :released, :revoked, :expired] default=:active
  relationships
    belongs-to :task entity=Task
    belongs-to :holder entity=Collaborator
  computed
    boolean :lapsed() { return &state === :active && &expiresAt <= now() }
  actions auto=[:read]
    create :acquire
      input
        &task
        integer :expectedVersion nullable
      validate
        check :taskReady [
          that=async ({ input, tx }) => (await derivedStateOf(tx, input.task)) === :ready
          code="claim.task-ready"
          message="the task is not ready to claim"
          details=({ input, tx }) => readinessOf(tx, input.task)
        ]
        check :versionMatches [
          that=async ({ input, tx }) => input.expectedVersion == null || input.expectedVersion === await taskVersionOf(tx, input.task)
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=async ({ input, tx }) => ({ expectedVersion: input.expectedVersion, actualVersion: await taskVersionOf(tx, input.task) })
        ]
      do
        run({ input, context, tx, actions }) {
          const lapsed = await tx.readClaim({ filter: { taskId: { eq: input.task }, state: { eq: :active }, expiresAt: { lte: now() } } });
          for (const claim of lapsed) await actions.endClaim({ id: claim.id, outcome: :expired, reason: "lease expired" }, { ...context, system: true });
        }
        set
          &holder=({ actor }) => actor.id
          &fence=() => (&task.maxFence ?? 0) + 1
          &acquiredAt=() => now()
          &expiresAt=() => leaseEnd(now())
        run [after=:write] ({ self, context, tx, actions }) {
          const open = await tx.readAssignment({ filter: { taskId: { eq: self.taskId }, endedAt: { nil: true } }, limit: 1 });
          if (open.length === 0) await actions.startAssignment({ task: self.taskId, assignee: self.holderId, reviewWaived: false }, { ...context, system: true });
          await actions.touchTask({ id: self.taskId }, { ...context, system: true });
        }
    update :renew
      input
        integer :fence
        integer :expectedVersion nullable
      validate
        check :currentFence [
          that=({ input }) => input.fence === &fence && input.fence === &task.maxFence
          code="claim.current-fence"
          message="the fence is not the current claim's; claim the task again"
          details=() => ({ currentFence: &task.maxFence, stale: false })
        ]
        check :claimActive [
          that=() => &state === :active
          code="claim.active"
          message="the claim has ended; claim the task again"
        ]
        check :claimNotExpired [
          that=() => &expiresAt > now()
          code="claim.expired"
          message="the lease has expired; claim the task again"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &task.version
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &task.version })
        ]
      do
        set
          &expiresAt=() => leaseEnd(now())
        run [after=:write] ({ self, context, actions }) {
          await actions.touchTask({ id: self.taskId }, { ...context, system: true });
        }
    update :release
      input
        integer :fence
        string :reason nullable
        integer :expectedVersion nullable
      validate
        check :currentFence [
          that=({ input }) => input.fence === &fence && input.fence === &task.maxFence
          code="claim.current-fence"
          message="the fence is not the current claim's; claim the task again"
          details=() => ({ currentFence: &task.maxFence, stale: false })
        ]
        check :claimActive [
          that=() => &state === :active
          code="claim.active"
          message="the claim has ended; claim the task again"
        ]
        check :claimNotExpired [
          that=() => &expiresAt > now()
          code="claim.expired"
          message="the lease has expired; claim the task again"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &task.version
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &task.version })
        ]
      do
        set
          &state=:released
          &endedAt=() => now()
          &endReason=({ input }) => input.reason ?? "released"
        run [after=:write] ({ self, context, actions }) {
          await actions.touchTask({ id: self.taskId }, { ...context, system: true });
        }
    update :revoke
      input
        string :reason min=1
        integer :expectedVersion nullable
      validate
        check :claimActive [
          that=() => &state === :active
          code="claim.active"
          message="the claim has ended; claim the task again"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &task.version
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &task.version })
        ]
      do
        set
          &state=:revoked
          &endedAt=() => now()
          &endReason=({ input }) => input.reason
        run [after=:write] ({ self, context, actions }) {
          await actions.touchTask({ id: self.taskId }, { ...context, system: true });
        }
    update :expire
      input
        string :reason nullable
      validate
        check :claimActive [
          that=() => &state === :active
          code="claim.active"
          message="the claim has ended; claim the task again"
        ]
      do
        set
          &state=:expired
          &endedAt=() => now()
          &endReason=({ input }) => input.reason ?? "lease expired"
        run [after=:write] ({ self, context, actions }) {
          await actions.touchTask({ id: self.taskId }, { ...context, system: true });
        }
    update :end
      input
        enum :outcome values=[:released, :revoked, :expired]
        string :reason
      validate
        check :claimActive [
          that=() => &state === :active
          code="claim.active"
          message="the claim has ended; claim the task again"
        ]
      do
        set
          &state=({ input }) => input.outcome
          &endedAt=() => now()
          &endReason=({ input }) => input.reason
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => isSystem(context) || actor.role != null
    policy :isMember actions=[&acquire, &renew, &release, &revoke]
      authorize-if=({ actor, context, tx }) => isSystem(context) || memberOf(tx, actor.id)
    policy :ownerOrMember actions=[&acquire, &renew, &release, &revoke]
      authorize-if=({ actor, context, tx }) => isSystem(context) || roleIn(tx, actor.id, [:owner, :member])
    policy :claimAssignee actions=[&acquire]
      authorize-if=({ input, actor, context, tx }) => isSystem(context) || assigneeMayClaimOf(tx, input.task, actor.id)
    policy :claimHolder actions=[&renew, &release]
      authorize-if=({ self, actor, context }) => isSystem(context) || self.holderId === actor.id
    policy :claimRevoker actions=[&revoke]
      authorize-if=({ self, actor, context, tx }) => isSystem(context) || revokesClaimOf(tx, self.taskId, actor.id)
    policy :internal actions=[&expire, &end]
      authorize-if=({ context }) => isSystem(context)
