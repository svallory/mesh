import { Task } from "./task.mesh.mx"
import { Collaborator } from "../identity/collaborator.mesh.mx"
import { claimsOf, claimToRelease, fenceDetailsOf, fenceIsCurrent, heldAClaimOf, inReviewOf, missingEvidenceOf, taskOpenOf, taskVersionOf } from "./work.helpers"
import { memberOf, roleIn } from "../identity/identity.helpers"

entity :Submission table="submissions"
  attributes
    uuid :id primary-key
    string :summary min=1 nullable
    json :evidence default=[]
    integer :fence nullable
    integer :taskVersion
    enum :state values=[:pending, :accepted, :returned, :withdrawn] default=:pending
    timestamp :submittedAt on=:create
  relationships
    belongs-to :task entity=Task
    belongs-to :submitter entity=Collaborator
  actions auto=[:read]
    create :submit
      input
        &task
        integer :fence min=1
        string :summary min=1
        &evidence
        integer :expectedVersion nullable
      validate
        check :taskOpen [
          that=({ input, tx }) => taskOpenOf(tx, input.task)
          code="task.open"
          message="the task is not open; reopen it first"
        ]
        check :currentFence [
          that=async ({ input, actor, tx }) => fenceIsCurrent(await claimsOf(tx, input.task), input.fence, actor.id, now())
          code="claim.current-fence"
          message="the fence is not your current claim; claim the task again"
          details=({ input, actor, tx }) => fenceDetailsOf(tx, input.task, input.fence, actor.id, now())
        ]
        check :nonePending [
          that=async ({ input, tx }) => !(await inReviewOf(tx, input.task))
          code="submission.none-pending"
          message="a submission is already pending; wait for its review or withdraw it"
        ]
        check :evidenceExists [
          that=async ({ input, tx }) => (await missingEvidenceOf(tx, input.evidence ?? &evidence)).length === 0
          code="evidence.exists"
          message="an evidence reference does not exist"
          details=async ({ input, tx }) => ({ missing: await missingEvidenceOf(tx, input.evidence ?? &evidence) })
        ]
        check :versionMatches [
          that=async ({ input, tx }) => input.expectedVersion == null || input.expectedVersion === await taskVersionOf(tx, input.task)
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=async ({ input, tx }) => ({ expectedVersion: input.expectedVersion, actualVersion: await taskVersionOf(tx, input.task) })
        ]
      do
        set
          &submitter=({ actor }) => actor.id
          &fence=({ input }) => input.fence
          &summary=({ input }) => input.summary
          &taskVersion=() => &task.version
        run [after=:write] ({ self, context, tx, actions }) {
          const live = claimToRelease(await tx.readClaim({ filter: { taskId: { eq: self.taskId } } }), now());
          if (live) await actions.endClaim({ id: live.id, outcome: :released, reason: "submitted" }, { ...context, system: true });
          await actions.touchTask({ id: self.taskId }, { ...context, system: true });
        }
    update :withdraw
      input
        string :reason nullable
        integer :expectedVersion nullable
      validate
        check :pending [
          that=() => &state === :pending
          code="submission.pending"
          message="the submission is not pending"
        ]
        check :versionMatches [
          that=({ input }) => input.expectedVersion == null || input.expectedVersion === &task.version
          code="expected-version"
          message="the task is at another version; read it again and retry"
          details=({ input }) => ({ expectedVersion: input.expectedVersion, actualVersion: &task.version })
        ]
      do
        set
          &state=:withdrawn
        run [after=:write] ({ self, context, actions }) {
          await actions.touchTask({ id: self.taskId }, { ...context, system: true });
        }
    update :settle
      input
        enum :outcome values=[:accepted, :returned, :withdrawn]
      validate
        check :pending [
          that=() => &state === :pending
          code="submission.pending"
          message="the submission is not pending"
        ]
      do
        set
          &state=({ input }) => input.outcome
    create :recordAccepted
      input
        &task
        &summary
        &evidence
        &fence
        &taskVersion
      do
        set
          &submitter=({ actor }) => actor.id
          &state=:accepted
  policies
    policy :membersRead types=[:read]
      authorize-if=({ actor, context }) => isSystem(context) || actor.role != null
    policy :isMember actions=[&submit, &withdraw]
      authorize-if=({ actor, context, tx }) => isSystem(context) || memberOf(tx, actor.id)
    policy :ownerOrMember actions=[&submit, &withdraw]
      authorize-if=({ actor, context, tx }) => isSystem(context) || roleIn(tx, actor.id, [:owner, :member])
    policy :claimHolder actions=[&submit]
      authorize-if=({ input, actor, context, tx }) => isSystem(context) || heldAClaimOf(tx, input.task, actor.id)
    policy :submissionSubmitter actions=[&withdraw]
      authorize-if=({ self, actor, context }) => isSystem(context) || self.submitterId === actor.id
    policy :internal actions=[&settle, &recordAccepted]
      authorize-if=({ context }) => isSystem(context)
